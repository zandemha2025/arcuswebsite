---
// One real report as a slide (DEPTH §B.5): the figure panel on the left (the report's headline number, as delivered,
// on the half-height amber highlighter, with a chart drawn at its true ratio), the report's own slide headline and its
// question on the right, the whole slide a link to the report. Used by the homepage's Real answers track and the
// /reports stack, so real answers look the same everywhere and never like the illustrative UI: navy field, white
// slides, real figures. Numbers are never changed or counted up; only the caption labels are shorter.
// who: also print the brand descriptor and summary under the question. Only where no client logo is on the page
//      (/reports); the homepage carries the logo row, so its slides name the kind of report only (SPINE §1).
// q:   the question's element: 'p' inside the homepage carousel, 'h2' where each slide is a section of the page.
import Arrow from './Arrow.astro';
interface Props { r: any; i: number; who?: boolean; q?: 'p' | 'h2' }
const { r, i, who = false, q = 'p' } = Astro.props;
const LABEL: Record<string, string> = {
  'content-report': 'the account’s average views, for one type of post',
  'audience-report': 'the views for an acted-out bit vs. a sincere post',
  'market-report': 'sources behind ten slides. Every number links to its page',
};
// Each slide's line is one of the report's own slide headlines (word for word): the finding, not the question again.
const ANSWER: Record<string, number> = { 'content-report': 0, 'audience-report': 0, 'market-report': 1 };
// Charts drawn at the true ratio of the figure above them (aria-hidden; the caption carries the number). Labels reuse
// the caption's words. Teal is what worked, coral what flopped, silver the resting baseline; periwinkle dots are sources.
const CHART: Record<string, [string, string, number][]> = {
  'content-report': [['One type of post', 'w', 1], ['The account’s average', 's', 1 / 2.4]],
  'audience-report': [['An acted-out bit', 'w', 1], ['A sincere post', 'f', 1 / 42]],
};
// The kind's dot: teal when the answer came from the brand's own numbers, periwinkle when it came from what people say.
const OWN_DATA = new Set(['content-report']);
const split = (n: string) => (n.endsWith('×') ? [n.slice(0, -1), '×'] : [n, '']);
const [num, x] = split(r.headline.n);
const chart = CHART[r.slug];
const line = r.slides[ANSWER[r.slug] ?? 0]?.big || r.title;
const Q = q;
---
<a href={`/reports/${r.slug}`} class="aslide" data-surface="light">
  <div class="sl-fig">
    <p class="sl-big"><span class="fig-hl">{num}{x && <small>{x}</small>}</span></p>
    <p class="sl-cap">{LABEL[r.slug] || r.headline.label}</p>
    {chart ? (
      <div class="sl-chart" aria-hidden="true">
        {chart.map(([l, c, v]) => <div class="sl-cb"><span>{l}</span><i class={`cbar ${c}`} style={`--v:${v.toFixed(4)}`}></i></div>)}
      </div>
    ) : (
      <svg class="sl-dots" viewBox="0 0 240 96" aria-hidden="true"><defs><pattern id={`dp-${i}`} width="12" height="12" patternUnits="userSpaceOnUse"><circle cx="6" cy="6" r="3.6" fill="#5B67A6"/></pattern></defs><rect x="0" y="0" width="240" height="84" fill={`url(#dp-${i})`}/><rect x="0" y="84" width="204" height="12" fill={`url(#dp-${i})`}/></svg>
    )}
  </div>
  <div class="sl-tx">
    <span class="pk"><i class={`dot ${OWN_DATA.has(r.slug) ? 'p1' : 'p3'}`} aria-hidden="true"></i>{r.kind}</span>
    <p class="sl-t">{line}</p>
    <div class="sl-q">
      <Q class="sl-qq">{r.question}</Q>
      {who && <p class="sl-who">{r.who}. {r.short}</p>}
      <span class="arrow sl-see">See the answer <Arrow /></span>
    </div>
  </div>
</a>
