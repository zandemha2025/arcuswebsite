---
// The short answer, high on every page. Written to be quoted as-is by search and AI answers. `quiet` sets it as plain
// muted prose with no card, for a page whose first screen already says the same thing (Try it free).
const { q, a, points = [], pointsLead = '', quiet = false } = Astro.props;
---
<aside class:list={['qanswer', quiet && 'plain']} aria-labelledby="qa-q">
  <h2 id="qa-q" class="h3"><span class="sr-only">The short answer: </span>{q}</h2>
  <p class="qa-a">{a}</p>
  {points.length > 0 && pointsLead && <p class="qa-pl">{pointsLead}</p>}
  {points.length > 0 && <ul class="dash">{points.map((p) => <li>{p}</li>)}</ul>}
</aside>
