---
// AVIF first, WebP fallback. `name` is the base file in public/img (e.g. "cinema" -> cinema-800/1600.{avif,webp}).
const { name, alt = '', sizes = '100vw', width = 1600, height = 1067, eager = false, class: cls, style, avif = true } = Astro.props;
const set = (ext) => `/img/${name}-800.${ext} 800w, /img/${name}-1600.${ext} 1600w`;
---
<picture>
  {avif && <source type="image/avif" srcset={set('avif')} sizes={sizes} />}
  <img src={`/img/${name}-1600.webp`} srcset={set('webp')} sizes={sizes} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" class={cls} style={style} />
</picture>
