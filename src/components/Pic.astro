---
// AVIF first, WebP fallback. `name` is the base file in public/img (e.g. "cinema" -> cinema-800/1600.{avif,webp}).
// `widths` lists the files that exist; the graded concert-duo has 800/1200/1600, so a 3x phone picks 1200, not 1600.
const { name, alt = '', sizes = '100vw', width = 1600, height = 1067, eager = false, class: cls, style, avif = true, widths = [800, 1600] } = Astro.props;
const big = Math.max(...widths);
const set = (ext) => widths.map((w) => `/img/${name}-${w}.${ext} ${w}w`).join(', ');
---
<picture>
  {avif && <source type="image/avif" srcset={set('avif')} sizes={sizes} />}
  <img src={`/img/${name}-${big}.webp`} srcset={set('webp')} sizes={sizes} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" class={cls} style={style} />
</picture>
