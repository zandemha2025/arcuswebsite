---
import { ASK_AI, BOOK_URL } from '../data/site.js';
const q = encodeURIComponent(ASK_AI);
const ai = [
  ['ChatGPT', `https://chatgpt.com/?q=${q}`],
  ['Claude', `https://claude.ai/new?q=${q}`],
  ['Google AI Mode', `https://www.google.com/search?udm=50&q=${q}`],
  ['Perplexity', `https://www.perplexity.ai/search?q=${q}`],
  ['Grok', `https://grok.com/?q=${q}`],
];
---
<footer class="foot on-dark">
  <div class="foot-top">
    <div class="foot-brand">
      <a href="/" class="logo" aria-label="Arcus home">arcus<i></i></a>
      <p class="muted">The truth layer for marketing at entertainment and lifestyle brands. Arcus connects every piece of your data, plus what people say online, into one place you own, and answers any question with the whole picture.</p>
    </div>
    <form class="foot-news-wrap" data-lead="newsletter" method="post" action="/api/lead" novalidate>
      <input type="hidden" name="form_id" value="newsletter" />
      <label for="fn-email" class="h3 foot-news-t">The Receipts</label>
      <p class="small muted">One number marketing gets wrong each month, and how to check it. <a class="ul" href="/newsletter">Past issues</a></p>
      <div data-body class="foot-news">
        <input id="fn-email" name="email" type="email" required data-req="Enter your email to subscribe." autocomplete="email" placeholder="you@yourbrand.com" />
        <span class="hp" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off" /></span>
        <button type="submit" class="jb wt sm" data-jelly data-loc="footer-news"><span class="bg"></span><span class="lb">Subscribe</span></button>
      </div>
      <p data-status class="form-err" hidden tabindex="-1" role="alert"></p>
      <p data-ok hidden tabindex="-1" role="status" class="small">You’re on the list. Next issue lands at the start of the month.</p>
    </form>
  </div>
  <section aria-label="Ask an AI about Arcus" class="foot-ai">
    <div>
      <p class="h2s foot-ai-t">Want the short version?</p>
      <p class="muted foot-ai-s">Ask your AI of choice what Arcus does and whether it’s right for your team.</p>
    </div>
    <div class="foot-ai-l">
      {ai.map(([n, h]) => <a class="fchip" href={h} rel="noopener" target="_blank" data-track="ask_ai_clicked" data-props={JSON.stringify({ engine: n })}>{n}</a>)}
    </div>
  </section>
  <nav aria-label="Footer" class="fmap">
    <div><b>Arcus</b><a href="/how-it-works">How it works</a><a href="/reports">Real answers</a><a href="/listening">What people say</a><a href="/integrations">Integrations</a><a href="/pricing">Pricing</a><a href="/free-report">Try it out for free</a></div>
    <div><b>Who it’s for</b><a href="/for">All teams</a><a href="/for/studios-and-streaming">Studios and streaming</a><a href="/for/spirits-and-beverage">Spirits and beverage</a><a href="/for/games-and-music">Games and music</a><a href="/for/fashion-and-beauty">Fashion and beauty</a></div>
    <div><b>Learn</b><a href="/library">Library</a><a href="/newsletter">The Receipts</a><a href="/events">Live Teardown</a><a href="/glossary">Glossary</a><a href="/compare">Compare</a><a href="/faq">FAQ</a></div>
    <div><b>Company</b><a href="/about">About</a><a href="/security">Security</a><a href="/partners">Partners</a><a href="/press">Press</a><a href="/make-the-case">Make the case</a><a href={BOOK_URL}>Book a call</a></div>
    <div><b>Legal</b><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/cookies">Cookies</a><button type="button" data-consent-open>Cookie settings</button><a href="/accessibility">Accessibility</a></div>
  </nav>
  <div class="foot-base"><span>© 2026 Arcus</span></div>
</footer>
