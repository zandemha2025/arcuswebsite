---
// Click-to-load YouTube video with VideoObject data. Renders nothing until a video exists in data/media.js.
import { VIDEOS } from '../data/media.js';
import { SITE } from '../data/site.js';
const { page } = Astro.props;
const v = VIDEOS.find((x) => x.page === page && x.youtubeId);
const thumb = v ? `https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg` : '';
const data = v && { '@context': 'https://schema.org', '@type': 'VideoObject', name: v.name, description: v.description, thumbnailUrl: thumb, uploadDate: v.uploadDate, duration: v.duration, embedUrl: `https://www.youtube-nocookie.com/embed/${v.youtubeId}`, publisher: { '@id': `${SITE}/#org` } };
---
{v && (
  <section class="wrap" style="padding-bottom:64px">
    <a class="video" href={`https://www.youtube.com/watch?v=${v.youtubeId}`} data-yt={v.youtubeId} aria-label={`Play video: ${v.name}`}>
      <img src={thumb} alt="" width="480" height="360" loading="lazy" />
      <span class="video-play" aria-hidden="true">▶</span>
    </a>
    <p class="small muted" style="margin-top:8px">{v.name}</p>
    <script type="application/ld+json" set:html={JSON.stringify(data)} />
  </section>
)}
