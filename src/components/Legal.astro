---
import Site from '../layouts/Site.astro';
import Crumbs from './Crumbs.astro';
const { title, h1, description, path, updated = 'October 16, 2026' } = Astro.props;
const crumbs = [{ name: h1, href: path }];
---
<Site title={`${title} | Arcus`} description={description} path={path} page="legal" crumbs={crumbs}>
  <header class="phero l" style="padding-bottom:32px">
    <Crumbs items={crumbs} />
    <h1 class="dh d96">{h1}</h1>
    <p class="small faint">Last updated {updated}.</p>
  </header>
  <section class="wrap blk-l"><div class="prose"><slot /></div></section>
</Site>
