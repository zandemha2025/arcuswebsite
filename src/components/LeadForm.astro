---
// The "Try it out for free" form: question first, then who you are. Posts to /api/lead with hidden first/last touch
// fields (added by site.js). data-lead="free_report" stays: the PostHog events, the lead score and Attio key off it.
// - The question is a radio group (fieldset + legend). site.js validates it as one group, puts one error under the
//   legend and focuses the first card when nothing is picked. ?start=<value> pre-picks a card (site.js).
// - "Something else" opens a notes box: "Your question", required while it's open (site.js), inert while closed, and
//   it never takes focus on its own. Without script it simply shows.
// - "How did you hear about us?" is asked on the thanks page, as one tap, so the send button sits closer to the top.
// - method/action: with no script (blocked, failed, or not loaded yet) the browser posts the form to /api/lead, which
//   answers with a redirect to the next page, so nothing lands in the URL. form_id and next ride along as fields.
// - The submit keeps its width while sending: the label crossfades to a spinner and "Sending".
import Arrow from './Arrow.astro';
interface Props { id?: string; loc?: string; label?: string }
const { id = 'fr', loc = 'free-report-form', label = 'Try it out for free' } = Astro.props;
// Each question carries its code dot (site.css .dot): worked-or-flopped (teal|coral), what people say (periwinkle),
// the next dollar (amber). "Something else" has none.
const QUESTIONS: [string, string, string][] = [
  ['what_worked', 'What worked, and what flopped?', 'wf'],
  ['audience_report', 'What is our audience saying about us?', 'p3'],
  ['next_dollar', 'Where should our next dollar go?', 'nx'],
  ['not_sure', 'Something else', ''],
];
---
<form class="form lf" data-lead="free_report" data-next="/free-report/thanks" method="post" action="/api/lead" novalidate aria-label={label}>
  <input type="hidden" name="form_id" value="free_report" /><input type="hidden" name="next" value="/free-report/thanks" />
  <div data-body class="lf-body">
    <fieldset class="qpick" id={`${id}-start`} data-req="Pick a question to start.">
      <legend class="qpick-l">Pick a question</legend>
      <div class="qgrid">
        {QUESTIONS.map(([v, t, k]) => (
          <label class="qopt"><input class="sr-only" type="radio" name="start_with" value={v} /><span class="qopt-i" aria-hidden="true"></span><span class="qopt-t">{t}</span>{k && <i class={`dot ${k}`} aria-hidden="true"></i>}</label>
        ))}
      </div>
      <div class="qmore" data-more="not_sure">
        <div class="qmore-in">
          <div class="fld">
            <label for={`${id}-notes`}>Your question</label>
            <textarea id={`${id}-notes`} name="notes" maxlength="2000" rows="3" placeholder="A launch coming up, a recap you’re unsure about, anything." aria-describedby={`${id}-notes-count`} data-req-open data-req="Tell us your question, even roughly."></textarea>
            <p id={`${id}-notes-count`} class="tiny faint fld-count num" data-count-for={`${id}-notes`} aria-live="polite" hidden></p>
          </div>
        </div>
      </div>
    </fieldset>
    <div class="row2 lf-who">
      <div class="fld"><label for={`${id}-name`}>Name</label><input id={`${id}-name`} name="name" required autocomplete="name" autocapitalize="words" enterkeyhint="next" data-req="Tell us your name." /></div>
      <div class="fld"><label for={`${id}-email`}>Work email</label><input id={`${id}-email`} name="email" type="email" required autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" enterkeyhint="next" data-work="1" placeholder="you@yourbrand.com" data-req="We need your email to send the answer." /></div>
    </div>
    <div class="fld"><label for={`${id}-company`}>Brand</label><input id={`${id}-company`} name="company" required autocomplete="organization" enterkeyhint="send" placeholder="Your brand" data-req="Which brand is this for?" data-from-email /></div>
    <span class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></span>
    <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITEKEY || ''} data-size="flexible"></div>
    <label class="check lf-news"><input type="checkbox" name="newsletter" value="yes" /> <span>Also send me The Receipts, our monthly newsletter</span></label>
    <button type="submit" class="jb k send" data-jelly data-loc={loc}>
      <span class="bg"></span>
      <span class="send-a"><span class="lb">Send my question</span><Arrow /></span>
      <span class="send-b" aria-hidden="true"><i class="spin"></i>Sending</span>
    </button>
    <p data-pending class="sr-only" role="status"></p>
    <p data-status class="form-err" hidden tabindex="-1" role="alert"></p>
    <p class="tiny muted lf-fine">Free, no card. We use this only to answer your question. <a class="ul" href="/security">How we handle your data</a> · <a class="ul" href="/free-report-terms">Terms</a> · <a class="ul" href="/privacy">Privacy</a></p>
  </div>
</form>
