---
// Per-page questions, with FAQPage data. Answers in brackets (unconfirmed) are shown but left out of the data.
const { items = [], title = 'Questions people ask', id = 'faq', link = true } = Astro.props;
const data = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.filter(([, a]) => !a.includes('[')).map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<section class="wrap" style="padding-bottom:96px" aria-labelledby={`${id}-h`}>
  <div class="split">
    <div class="sec-h" style="margin:0">
      <h2 id={`${id}-h`} class="dh d56">{title}</h2>
      {link && <p class="muted">More in the <a class="ul" href="/faq">full FAQ</a>, or <a class="ul" href="/book">ask us on a call</a>.</p>}
    </div>
    <div class="qa">
      {items.map(([q, a], i) => (
        <details data-q={`${id}-${i}`}><summary>{q}<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 3v12M3 9h12"/></svg></summary><p class="a">{a}</p></details>
      ))}
    </div>
  </div>
  {data.mainEntity.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(data)} />}
</section>
