---
// Closing call to action. Three looks so pages don't end the same way.
interface Props { variant?: 'ink' | 'or' | 'gr'; title: string; lines?: string[]; body?: string; primary?: [string, string]; secondary?: [string, string]; loc?: string }
const { variant = 'ink', title, lines, body = 'Bring the question you’re least sure about: whether an agency’s results really happened, which posts work, what your audience says, or anything else. We answer it with your own numbers and what people say online, then walk you through it in 30 minutes. Free, no card.', primary = ['Bring us one question', '/free-report'], secondary = ['Book a call', '/book'], loc = 'close' } = Astro.props;
const ls = lines || [title];
---
<section class={`slab s-${variant} close${variant === 'ink' ? ' on-dark' : ''}`} aria-labelledby={`${loc}-h`}>
  <div class="close-in">
    <h2 id={`${loc}-h`} class="dh d96 wipe" data-reveal>{ls.map((l) => <span class="ln">{l}</span>)}</h2>
    <p class="lead">{body}</p>
    <div class="btnrow">
      <a href={primary[1]} class={`jb ${variant === 'ink' ? 'st' : 'k'}`} data-jelly data-loc={loc}><span class="bg"></span><span class="lb">{primary[0]}</span></a>
      {secondary && <a href={secondary[1]} class={`jb ${variant === 'ink' ? 'gh' : 'ln'}`} data-jelly data-loc={`${loc}-2`}><span class="bg"></span><span class="lb">{secondary[0]}</span></a>}
    </div>
  </div>
</section>
