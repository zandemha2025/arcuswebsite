---
import Site from '../../layouts/Site.astro';
import Crumbs from '../../components/Crumbs.astro';
import Close from '../../components/Close.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import { GLOSS as GLOSSARY } from '../../data/all.js';
import { SITE } from '../../data/site.js';
const crumbs = [{ name: 'Glossary', href: '/glossary' }];
const sorted = [...GLOSSARY].sort((a, b) => a.name.localeCompare(b.name));
const schema = [{ '@type': 'DefinedTermSet', '@id': `${SITE}/glossary#set`, name: 'Arcus marketing measurement glossary', url: `${SITE}/glossary`, hasDefinedTerm: sorted.map((g) => ({ '@type': 'DefinedTerm', name: g.name, description: g.def, url: `${SITE}/glossary/${g.slug}` })) }];
---
<Site title="Marketing measurement glossary | Arcus" description="What attribution, incrementality, ROAS, view-through conversions, holdout tests and other marketing measurement terms mean, in one sentence each." path="/glossary" page="glossary" crumbs={crumbs} schema={schema}>
  <header class="phero l">
    <Crumbs items={crumbs} />
    <h1 class="dh d96">What the words in your marketing reports mean.</h1>
    <QuickAnswer q="Why does this glossary exist?" a="Campaign recaps are full of terms that make numbers sound more certain than they are. Each entry says what the term means in one sentence, why it matters, and the question to ask about it." />
  </header>
  <section class="wrap blk">
    <div>
      {sorted.map((g) => (
        <a href={`/glossary/${g.slug}`} class="listrow gl">
          <span class="h3">{g.name}</span>
          <span class="muted">{g.def}</span>
          <span class="go" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
        </a>
      ))}
    </div>
  </section>
  <Close variant="paper" lines={['Rather we answer', 'it for you?']} loc="glossary-close" />
</Site>
