---
import Site from '../../layouts/Site.astro';
import Arrow from '../../components/Arrow.astro';
import HeardAsk from '../../components/HeardAsk.astro';
import { CAL_URL } from '../../data/site.js';
// With a scheduling link set in site.js (TBD.calLink, read through CAL_URL), initPrefill puts the calendar in
// [data-cal] with the name and email filled in (a plain link without JavaScript), and "Before the call" sits under the
// receipt. Until then nothing here is a placeholder: the lead says we'll email times, and the right column holds the
// faster way (email us) over "Before the call". The header carries no "Try it out for free" here: this visitor just
// chose the call.
const calLive = Boolean(CAL_URL);
---
<Site title={calLive ? 'Pick a time | Arcus' : 'Almost booked | Arcus'} description={calLive ? 'Pick a time for your call with Arcus.' : 'Your call with Arcus is almost booked. We’ll email you times.'} path="/book/thanks" page="thanks" noindex navCta={false}>
  <section class="split-hero" data-prefill style="align-items:start">
    <div style="display:flex;flex-direction:column;gap:24px;position:relative">
      <h1 class="dh d96">Almost booked, <span data-lead-name>thanks</span>.</h1>
      <p class="lead">{calLive ? 'Pick a time and you’ll get an invite right away. Add anyone you want on the call.' : 'We’ll email you times for the call. Add anyone you want to the invite.'}</p>
      <div class="rc wide" style="position:relative">
        <div class="hd">Call with Arcus</div>
        <div class="r"><span>Length</span><span>30 minutes</span></div>
        <div class="r"><span>Pitch deck</span><span>None</span></div>
        <div class="r"><span>Your questions</span><span>All of them</span></div>
        <div class="bar"></div>
      </div>
      {calLive && (
        <div class="card frt-card">
          <p class="h3">Before the call</p>
          <a href="/reports" class="arrow">Flip through real answers <Arrow /></a>
          <a href="/library/incrementality-without-the-math" class="arrow">Read how to test before you move budget <Arrow /></a>
        </div>
      )}
      <HeardAsk />
    </div>
    {calLive ? (
      <div data-cal={CAL_URL} class="card bk-cal">
        <p class="small"><a class="ul" href={CAL_URL} rel="noopener">Pick a time on our calendar</a>, or email us at <a class="ul" href="mailto:hello@usearcus.ai">hello@usearcus.ai</a> and we’ll send times.</p>
      </div>
    ) : (
      <div class="frt-side">
        <div class="card frt-card frt-main">
          <h2 class="h2s">In a hurry?</h2>
          <p class="muted">Email <a class="ul" href="mailto:hello@usearcus.ai">hello@usearcus.ai</a> and we’ll send times.</p>
        </div>
        <div class="card frt-card">
          <p class="h3">Before the call</p>
          <a href="/reports" class="arrow">Flip through real answers <Arrow /></a>
          <a href="/library/incrementality-without-the-math" class="arrow">Read how to test before you move budget <Arrow /></a>
        </div>
      </div>
    )}
  </section>
</Site>
