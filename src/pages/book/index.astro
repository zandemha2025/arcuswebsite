---
import Site from '../../layouts/Site.astro';
import Crumbs from '../../components/Crumbs.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import PageFAQ from '../../components/PageFAQ.astro';
import Arrow from '../../components/Arrow.astro';
import { TEAM } from '../../data/site.js';
const crumbs = [{ name: 'Book a call', href: '/book' }];
---
<Site title="Book a call with Arcus | Arcus" description="Book 30 minutes with the Arcus team. No pitch. Bring your questions about your spend, your audience or your data, and we’ll answer them." path="/book" page="book" crumbs={crumbs} heroCta>
  {/* Grid areas, not order: wide screens put the form beside the copy; phones read the H1 and lead, then the form,
      then what to bring and who you'll talk to. While this section is on screen the header's "Try it out for free"
      stays unlit (data-unlit-zone): the form is this screen's one action. A visitor who already sent the Try it free
      form gets name, email and brand filled in (data-prefill-form, site.js). */}
  <section class="split-hero bk" data-unlit-zone>
    <div class="bk-copy stack-24">
      <Crumbs items={crumbs} />
      <h1 class="dh d96">No pitch. Bring your questions.</h1>
      <p class="lead">30 minutes with the people who build Arcus. Ask about your spend, your audience, your data or how we work. If we’re not a fit, we’ll tell you.</p>
    </div>
    <form class="form paper bk-form" data-lead="book" data-next="/book/thanks" data-prefill-form method="post" action="/api/lead" novalidate aria-labelledby="bk-h">
      <input type="hidden" name="form_id" value="book" /><input type="hidden" name="next" value="/book/thanks" />
      <div data-body style="display:flex;flex-direction:column;gap:18px">
        <h2 id="bk-h" class="h3">Book a call</h2>
        <div class="row2">
          <div class="fld"><label for="bk-name">Your name</label><input id="bk-name" name="name" required autocomplete="name" data-req="Tell us your name." /></div>
          <div class="fld"><label for="bk-email">Work email</label><input id="bk-email" name="email" type="email" required data-req="We need your email to send the invite." data-work="1" autocomplete="email" placeholder="you@yourbrand.com" /></div>
        </div>
        <div class="fld"><label for="bk-co">Brand</label><input id="bk-co" name="company" required autocomplete="organization" placeholder="Your brand" data-from-email data-req="Which brand is this for?" /></div>
        <div class="fld">
          <label for="bk-topic">What do you want to talk about?</label>
          <select id="bk-topic" name="topic" required data-req="Pick a topic so we bring the right person.">
            <option value="">Pick one</option>
            <option value="spend">Which of our spend is working</option>
            <option value="audience">What our audience says</option>
            <option value="pricing">Pricing and setup</option>
            <option value="security">Security and legal</option>
            <option value="other">Something else</option>
          </select>
        </div>
        <div class="fld"><label for="bk-notes">Anything we should know? <span class="hint">(optional)</span></label><textarea id="bk-notes" name="notes" placeholder="A launch coming up, a recap you’re unsure about, anything."></textarea></div>
        <label class="check"><input type="checkbox" name="bring_brendon" value="yes" /> <span>Bring Brendon, our CTO, for technical, security or legal questions</span></label>
        <span class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></span>
        <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITEKEY || ''}></div>
        <button type="submit" class="jb k" data-jelly data-loc="book-form"><span class="bg"></span><span class="lb">Pick a time</span></button>
        <p data-status class="form-err" hidden tabindex="-1" role="alert"></p>
        <p class="tiny faint">Next you’ll pick a time. <a class="ul" href="/privacy">Privacy</a></p>
      </div>
    </form>
    <div class="bk-more stack-24">
      <ul class="nolist yeslist">
        <li>Bring a recap you’re unsure about and we’ll tell you where we’d start</li>
        <li>Bring your security or legal questions. Brendon can join</li>
        <li>Leave with a next step, even if it isn’t us</li>
      </ul>
      <div style="display:flex;flex-direction:column;gap:12px">
        <p class="small faint">Who you’ll talk to</p>
        <div style="display:flex;gap:20px;flex-wrap:wrap">
          {TEAM.filter((t) => ['min-kwak','brendon-ghaderi'].includes(t.slug)).map((t) => <a class="person" href={`/about/${t.slug}`}><span class="av">{t.initials}</span><span><b>{t.name}</b><br/><span class="small muted">{t.title}</span></span></a>)}
        </div>
      </div>
    </div>
  </section>
  <section class="wrap blk">
    <QuickAnswer q="What happens on an Arcus call?" a="You talk to someone who builds Arcus for 30 minutes. You ask questions about your spend, audience or data. We tell you where we’d start and whether we’re a fit. There’s no pitch deck." />
  </section>
  <PageFAQ id="book-faq" link={false} items={[
    ['Do I need to prepare anything?', 'No. If you have a recap or report you’re unsure about, bring it. It makes the call more useful.'],
    ['Can my boss or legal join?', 'Yes. Add them to the invite after you book. If legal is joining, check the box to bring Brendon.'],
    ['Would trying it free be faster?', 'If you already know what you want answered, yes. Pick your question and we’ll walk you through the answer.'],
  ]} />
  <section class="wrap blk"><a href="/free-report" class="arrow">Skip the call and try it out for free <Arrow /></a></section>
</Site>
