---
import Video from '../components/Video.astro';
import Site from '../layouts/Site.astro';
import Crumbs from '../components/Crumbs.astro';
import Close from '../components/Close.astro';
import AnswerStage from '../components/AnswerStage.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import PageFAQ from '../components/PageFAQ.astro';
import Related from '../components/Related.astro';
import ToolsStrip from '../components/ToolsStrip.astro';
import Arrow from '../components/Arrow.astro';
import AskRow from '../components/AskRow.astro';
import * as site from '../data/site.js';
const { SITE } = site;
const { BOOK_URL } = site;
const crumbs = [{ name: 'How it works', href: '/how-it-works' }];
// Six steps in the order of the story: try it free, then we build it (connect, own, customize), then the answers.
// Each receipt's stamp inks in its meaning: periwinkle is Arcus acting or what people say, teal is checked, amber is the answer.
// Keep the #start, #build, #check, #listen and #report anchors: llms.txt and other pages link to them.
const steps = [
  { id: 'start', n: '01', t: 'Try it free', b: 'Pick the question you’re least sure about: which spend worked, which posts work, what your audience says, or anything else. We answer it with your own numbers and what people say online, then walk you through the answer on a 30-minute call. No card.', you: 'Pick a question. Give access to the accounts it touches. Join the call.', rc: [['Your question', 'Received'], ['Your own numbers', 'Connected'], ['Walkthrough', 'Booked']], stamp: 'Received', tone: '' },
  { id: 'build', n: '02', t: 'We connect your data', b: 'If you go ahead, we connect every system you run, from sales, viewers or players, email and CRM to ad accounts, social accounts and agency reports. It all goes into one place you own, inside your own setup: your own data lake. It takes about three months. We test every number on the way in, and answers arrive along the way.', you: 'Approve each step. That’s it.', rc: [['Sales, tickets, sign-ups', 'Connected'], ['Email and CRM', 'Connected'], ['Ad accounts', 'Connected'], ['Agency reports', 'Connected'], ['Social accounts', 'Connected']], stamp: 'Approved', tone: 'ink-ok' },
  { id: 'context', n: '03', t: 'Built around your brand', b: 'We write down what we learn about your brand: your products, seasons, audiences, goals and the numbers you report on. That’s your context layer, customized to you, so every answer starts from your business instead of a template.', you: 'Tell us what matters. We write it down.', rc: [['Products and drops', 'Written down'], ['Seasons and launches', 'Written down'], ['Audiences', 'Written down'], ['The numbers you report on', 'Written down']], stamp: 'Yours', tone: '' },
  { id: 'check', n: '04', t: 'We count every result once', b: 'Your ad accounts, partners and creators each report their own results, and each ad platform gives itself credit. We match every reported sale, ticket or sign-up to your own numbers and count it once. When you need proof that something caused sales, we run ads in some regions and pause them in others, then compare sales. That’s a regions-on, regions-off test.', you: 'Nothing. We send what we find.', rc: [['Each channel’s results', 'Lined up'], ['Same sale, two reports', 'Counted once'], ['Your own numbers', 'Matched'], ['Proof it caused sales', 'Tested']], stamp: 'Counted once', tone: 'ink-ok' },
  { id: 'listen', n: '05', t: 'We add what people say', b: 'We read what people say about you on Reddit, TikTok, YouTube, Discord, Twitch, Kick, Facebook groups, Google, Goodreads, Fable and more, plus any listening tool you already pay for. We count what comes up, and line it up with your sales and customers.', you: 'Tell us where your audience hangs out, if you know.', rc: [['Comments counted', '6,622'], ['Posts sorted', '293'], ['Reddit questions', '4,283'], ['Voice rules', '4']], stamp: 'Counted', tone: '' },
  { id: 'report', n: '06', t: 'You ask anything', b: 'Anyone on your team can ask anything, and the answer draws on everything we connected. Each answer is a few slides: the answer on top, where every number came from, and what to keep, test and stop. Answers land in Slack, email or Sheets, plus regular check-ins on the schedule you pick. A person on our team reads every answer before you do.', you: 'Ask. Read the slides. Decide.', rc: [['Keep', 'Hosting hacks'], ['Test', 'Friend-group frame'], ['Stop', '3D animation']], stamp: 'Answered', tone: 'ink-nx' },
];
const howto = { '@type': 'HowTo', name: 'How Arcus works', step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.t, text: s.b, url: `${SITE}/how-it-works#${s.id}` })) };
---
<Site title="How Arcus works: try it free, then we build it for you | Arcus" description="Pick a question and we answer it free. Then, in about three months, we connect all your marketing data in one place you own, built around your brand." path="/how-it-works" active="how" page="how" crumbs={crumbs} schema={[howto]} heroCta>
  <section class="split-hero">
    <div class="stack-24">
      <Crumbs items={crumbs} />
      <h1 class="dh d96"><span class="ln">Try it free.</span><span class="ln">Then we build it for you.</span></h1>
      <p class="lead">You don’t need a data team. Here’s what happens, what we do, and what we need from you.</p>
      <div class="btnrow l">
        <a href="/free-report" class="jb k" data-jelly data-loc="how-hero"><span class="bg"></span><span class="lb">Try it out for free</span><Arrow /></a>
        <a href={BOOK_URL} class="jb ln" data-jelly data-loc="how-hero-2"><span class="bg"></span><span class="lb">Book a call</span></a>
      </div>
      <p class="small muted">Free, no card. Pick a question and we answer it with your own numbers.</p>
    </div>
    <AnswerStage shared />
  </section>

  <section class="wrap blk">
    <QuickAnswer q="How does Arcus work?" a="You pick a question and we answer it free, with your own numbers and what people say online. If you go ahead, we connect every system you run into one place you own, inside your own setup: sales, viewers or players, email and CRM, ads, social and agency reports. We build it around your brand, in about three months. After that, anyone on your team can ask anything, and the answer sees the whole picture." />
  </section>
  <Video page={'/how-it-works'} />

  <section class="wrap blk">
    <div class="split">
      <div class="stepper" data-stepper>
        {steps.map((s) => (
          <section id={s.id} data-step={s.id} aria-labelledby={`${s.id}-h`}>
            <span class="sp-n" aria-hidden="true">{s.n}</span>
            <h2 id={`${s.id}-h`} class="h2s">{s.t}</h2>
            <p class="muted step-b">{s.b}</p>
            <p class="small"><b>What you do:</b> {s.you}</p>
          </section>
        ))}
      </div>
      <div class="sticky-art" aria-hidden="true">
        <div class="steprc" data-stepper-art data-state="start">
          {steps.map((s) => (
            <div class={`rc wide st-${s.id}`}>
              <div class="hd">Step {s.n}</div>
              {s.rc.map(([k, v]) => <div class="r"><span>{k}</span><span>{v}</span></div>)}
              <div class="bar"></div>
              <span class:list={['stamp', s.tone]}>{s.stamp}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
    <AskRow loc="how-steps" class="after" note="Step 01 is free. No card." />
  </section>

  <section class="slab s-ink on-dark" aria-labelledby="ai-h">
    <div class="split mid">
      <div class="sec-h m0">
        <h2 id="ai-h" class="dh d72"><span class="ln">Our AI only does</span><span class="ln">the jobs we approve.</span></h2>
        <p class="lead">It can’t do a backflip. Every step it takes is logged, and a person on our team reads every answer before you do.</p>
        <a href="/security" class="arrow">How we handle your data <Arrow /></a>
      </div>
      <div class="rc wide">
        <div class="hd">Approved jobs</div>
        <div class="r pass"><span>Count results against your numbers</span><span>Allowed</span></div>
        <div class="r pass"><span>Count comments and posts</span><span>Allowed</span></div>
        <div class="r pass"><span>Draft the slides</span><span>Allowed</span></div>
        <div class="r pass"><span>Log every step</span><span>Allowed</span></div>
        <div class="r x"><span>Backflip</span><span>Not allowed</span></div>
        <div class="bar"></div>
      </div>
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="types-h">
    <div class="sec-h">
      <h2 id="types-h" class="dh d72">The four questions we get most.</h2>
      <p class="lead muted">You can ask anything. These four come up first. Three have a real answer you can flip through. The fourth you can try on your own numbers.</p>
    </div>
    <div class="tbl" tabindex="0" role="region" aria-label="The four report types, table">
      <table>
        <thead><tr><th scope="col">Report</th><th scope="col">The question it answers</th><th scope="col">What we use</th><th scope="col">See one</th></tr></thead>
        <tbody>
          <tr><th scope="row">Spend report</th><td data-label="The question it answers">Which of our spend paid off, and what fell flat?</td><td data-label="What we use">Your own numbers, your ad accounts, agency and partner reports</td><td data-label="See one"><a class="ul" href="/free-report?start=what_worked">Try it free</a></td></tr>
          <tr><th scope="row">Content report</th><td data-label="The question it answers">Which posts get watched and shared, and what should we make next?</td><td data-label="What we use">Your social accounts, posting calendar, sales</td><td data-label="See one"><a class="ul" href="/reports/content-report">See the content report</a></td></tr>
          <tr><th scope="row">Audience report</th><td data-label="The question it answers">How does our audience talk, and what do they want from us?</td><td data-label="What we use">Reddit, TikTok, YouTube, Discord, Twitch and more, plus your data</td><td data-label="See one"><a class="ul" href="/reports/audience-report">See the audience report</a></td></tr>
          <tr><th scope="row">Market report</th><td data-label="The question it answers">What happened when brands like us made this move?</td><td data-label="What we use">Filings, trade press, retailer and marketplace data</td><td data-label="See one"><a class="ul" href="/reports/market-report">See the market report</a></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="wrap blk-l" aria-labelledby="who-h">
    <div class="sec-h"><h2 id="who-h" class="dh d72">Who does what.</h2></div>
    <div class="honest">
      <div>
        <p class="h3">Your team</p>
        <ul class="nolist yeslist">
          <li>Picks a question to start</li>
          <li>Approves access to the accounts we connect</li>
          <li>Tells us the questions that matter</li>
          <li>Reads a few slides, and decides</li>
        </ul>
      </div>
      <div>
        <p class="h3">Arcus</p>
        <ul class="nolist yeslist">
          <li>Connects every system into one place you own, and keeps it running</li>
          <li>Counts every result once against your own numbers</li>
          <li>Reads and counts what your audience says</li>
          <li>Runs tests when you need proof</li>
          <li>Answers every question, and walks you through it</li>
        </ul>
      </div>
    </div>
  </section>

  {/* No padding of its own: the block above pads its foot, and the tools strip below brings its own head room. */}
  <section class="wrap" aria-labelledby="need-h">
    <div class="split">
      <div class="sec-h m0">
        <h2 id="need-h" class="dh d72">What we’ll ask you for.</h2>
        <p class="lead muted">No surprises. This is the full list for setup. Trying it free needs only what your question touches.</p>
        <AskRow loc="how-need" />
      </div>
      <ol class="numlist">
        {[
          ['Your own numbers', 'Sales, tickets, sign-ups, streams or viewing. From wherever they live: your site, a retailer, a ticketing partner, a spreadsheet.'],
          ['Access to your ad accounts', 'Meta, Google, TikTok and so on. We walk you through it, and you approve exactly what we can access before we connect anything.'],
          ['Your social accounts', 'For content reports: what you posted and how it did.'],
          ['Your email and customer lists', 'To see who buys, and what came from your own channels.'],
          ['The questions you most want answered', 'Which creators work? Is the retail launch landing? What do fans want next? We start with these.'],
          ['One person to approve each step', 'Usually the brand lead. About 30 minutes for each walkthrough.'],
        ].map(([t, d], i) => <li><span class="nl-n">{i + 1}</span><span><b class="h3 db">{t}</b><span class="muted">{d}</span></span></li>)}
      </ol>
    </div>
  </section>

  <ToolsStrip />

  <PageFAQ id="how-faq" items={[
    ['How long does setup take?', 'About three months from kickoff to everything running. Findings arrive along the way, so you don’t wait three months to learn something.'],
    ['Do we have to change our tools or partners?', 'No. We connect to what you already use, with the accounts you already have.'],
    ['What exactly do you build for us?', 'They’re the two things we build for you. One place that holds all your data, inside your own setup, is your own data lake, and it stays yours. What we learn about your brand (your products, seasons, audiences, goals and the numbers you report on), written down so every answer starts from it, is your context layer.'],
    ['Is this attribution?', 'No. Attribution decides who gets credit. We check whether the credit is real: each result is counted once against your own numbers, and anything you’d move budget on gets a simple test.'],
    ['Who reads the answers before we do?', 'A person on our team reads every answer, checks the numbers and writes up what it means.'],
    ['What if most of our sales happen in stores, theaters or on other platforms?', 'We work with the numbers you have: retail and distributor data, ticketing partners, streaming dashboards, app stores. Where the data is too thin to call, we say so, and a regions-on, regions-off test often fills the gap.'],
    ['How often do answers come?', 'On the schedule you pick, usually monthly, plus whenever you have a question before a launch or a budget meeting.'],
    ['What does an answer look like?', 'A few slides. The first says what we found. The middle shows the evidence, with a source for every number. The last says what to keep, test and stop.'],
  ]} />

  <Related items={[
    ['What people say', 'Every place we read, and how it lines up with your own numbers.', '/listening'],
    ['Real answers', 'Real questions brands brought us, with names removed.', '/reports'],
    ['Pricing', 'Try it free, then setup and monthly, quoted for your brand.', '/pricing'],
  ]} />

  <Close variant="paper" lines={['Start with', 'step one.']} loc="how-close" />
</Site>
