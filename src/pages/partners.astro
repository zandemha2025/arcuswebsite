---
import Site from '../layouts/Site.astro';
import Crumbs from '../components/Crumbs.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import PageFAQ from '../components/PageFAQ.astro';
import Close from '../components/Close.astro';
const crumbs = [{ name: 'Partners', href: '/partners' }];
---
<Site title="Partners: for advisors and consultants | Arcus" description="For fractional CMOs, finance advisors, talent managers and consultants whose clients need the whole picture. Introduce a brand, and get paid if they sign." path="/partners" page="partners" crumbs={crumbs} heroCta>
  <section class="split-hero" style="align-items:start" data-unlit-zone>
    <div class="stack-24">
      <Crumbs items={crumbs} />
      <h1 class="dh d96">Help your clients see the whole picture.</h1>
      <p class="lead">Your clients’ data is in pieces: every team, tool and partner holds its own piece. Good advice needs the whole picture. Introduce a brand to Arcus. They try it free: we answer one question with their own numbers and what people say online. If they sign, you get paid.</p>
      <QuickAnswer q="How does the Arcus partner program work?" a="Introduce a brand team. They try Arcus free: we answer one of their questions with their own numbers, then walk them through it in 30 minutes. If the brand signs, we pay you, on terms agreed up front." />
    </div>
    <form class="form paper" data-lead="partner" method="post" action="/api/lead" novalidate aria-labelledby="pt-h">
      <input type="hidden" name="form_id" value="partner" />
      <div class="stack-16" data-body>
        <h2 id="pt-h" class="h3">Become a partner</h2>
        <div class="row2">
          <div class="fld"><label for="pt-name">Your name</label><input id="pt-name" name="name" required autocomplete="name" data-req="Tell us your name." /></div>
          <div class="fld"><label for="pt-email">Email</label><input id="pt-email" name="email" type="email" required autocomplete="email" data-req="We need your email to send your partner link." /></div>
        </div>
        <div class="fld"><label for="pt-co">Firm</label><input id="pt-co" name="company" required autocomplete="organization" data-req="Which firm are you with?" /></div>
        <div class="fld"><label for="pt-type">What do you do?</label><select id="pt-type" name="topic" required data-req="Pick the closest match."><option value="">Pick one</option><option value="fractional_cmo">Fractional CMO</option><option value="finance">CFO or finance advisor</option><option value="talent">Talent manager</option><option value="consultant">Consultant</option><option value="other">Something else</option></select></div>
        <div class="fld"><label for="pt-notes">Who do you work with? <span class="hint">(optional)</span></label><textarea id="pt-notes" name="notes" placeholder="Three beverage brands and a streamer."></textarea></div>
        <span class="hp" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off" /></span>
        <button type="submit" class="jb k" data-jelly data-loc="partners-form"><span class="bg"></span><span class="lb">Become a partner</span></button>
        <p data-status class="form-err" hidden tabindex="-1" role="alert"></p>
      </div>
      <p data-ok hidden tabindex="-1" role="status" class="ok"><b>Thanks.</b> Min will send your partner link by email.</p>
    </form>
  </section>
  <section class="wrap blk">
    <h2 class="dh d56" style="margin-bottom:20px">Who it’s for.</h2>
    <div class="tiles" style="--n:4">
      <div class="tile"><p class="h3">Fractional CMOs</p><p class="muted">See what the marketing you inherited is actually doing, in your first month.</p></div>
      <div class="tile"><p class="h3">CFOs and finance advisors</p><p class="muted">See which spend is paying off, against the brand’s own numbers, before the next budget.</p></div>
      <div class="tile"><p class="h3">Talent managers</p><p class="muted">Show what a brand deal did, with the conversation around it counted.</p></div>
      <div class="tile"><p class="h3">Consultants</p><p class="muted">Put numbers with a source under your advice. You see the whole picture, and you stay the strategic lead.</p></div>
    </div>
  </section>
  <section class="wrap blk">
    <div class="honest">
      <div><h2 class="h3">What your clients get</h2><p class="muted">They try it free: one question, answered with their own numbers and what people say online. Then a 30-minute walkthrough of the answer and the one test worth running next.</p></div>
      <div><h2 class="h3">What you get</h2><ul class="nolist yeslist"><li>Payment when a brand you introduce signs</li><li>A seat in the walkthrough, if your client wants you there</li><li>A seat at our monthly Live Teardown</li><li>Early access to Arcus research</li><li>One named contact: Min Kwak, Chief Revenue Officer</li></ul></div>
    </div>
  </section>
  <PageFAQ id="pt-faq" items={[
    ['Do I see my client’s data?', 'Only if your client gives permission in writing. We share findings with the brand. If they want you in the walkthrough, you’re welcome.'],
    ['Where do the brand’s other partners fit in?', 'We connect the reports they already send the brand. The brand decides who sees the answers.'],
    ['Can agencies join?', 'Agencies are welcome to send clients our way. There’s no referral fee.'],
    ['What kinds of brands are a good fit?', 'In-house marketing teams at entertainment and lifestyle brands (studios, streamers, drinks, games, music, fashion and beauty) that spend serious money on marketing and want to know what it did.'],
    ['What does it cost my client after they try it free?', 'If they want everything connected, we scope the setup and the monthly work for their brand and quote it once they’ve seen their free answer. The Pricing page explains how it works.'],
  ]} />
  <Close variant="navy" title="Know a team that needs answers?" lines={['Know a team that', 'needs answers?']} primary={['Become a partner', '#pt-h']} body="Introduce one brand. They try it free, with a 30-minute walkthrough. If they sign, you get paid." loc="partners-close" />
</Site>
