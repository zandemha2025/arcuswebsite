---
import Site from '../../layouts/Site.astro';
import Crumbs from '../../components/Crumbs.astro';
import LeadForm from '../../components/LeadForm.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import PageFAQ from '../../components/PageFAQ.astro';
import InsightCard from '../../components/InsightCard.astro';
import Arrow from '../../components/Arrow.astro';
import ClientWall from '../../components/ClientWall.astro';
import { SITE, TBD, BOOK_URL } from '../../data/site.js';
const crumbs = [{ name: 'Try it free', href: '/free-report' }];
// The turnaround shows once TBD.turnaround (site.js) holds a real time; filled() there keeps a bracketed or "TBD" value
// out. Until then the receipt and the FAQ say we tell you the turnaround before we start.
const turnaround = TBD.turnaround;
const schema = [{ '@type': 'Offer', name: 'First question, answered free', price: '0', priceCurrency: 'USD', url: `${SITE}/free-report`, seller: { '@id': `${SITE}/#org` }, description: 'Pick one marketing question. Arcus answers it with your own numbers and what your audience says, then walks you through it.' }];
// Three outcomes, worded apart from the homepage hero (spine §3.3). Each wears the triad with its own shape, so color
// is never the only cue: paid off (teal, up), fell flat (coral, down), the next dollar (amber, right).
const ARROW = { tw: 'M8 13V3M4 7l4-4 4 4', tf: 'M8 3v10M4 9l4 4 4-4', tn: 'M3 8h10M9 4l4 4-4 4' };
const OUTCOMES = [['Which spend paid off', 'tw'], ['What fell flat', 'tf'], ['Where to put the next dollar', 'tn']];
// The receipt itemizes a $0 total, so it stays a receipt (an insight card answers; a receipt itemizes).
const GET = ['The answer, on top', 'Where every number came from', 'What to keep, test and stop', 'A 30-minute walkthrough'];
// What the sample shows, in the order the markers sit on the card. Note 2 marks "Next: test paying them…", so it says
// "what to do next" (the card has a test, not keep and stop lines).
const ANNOS = ['The answer, on top', 'What to do next', 'Where every number came from'];
const STEPS = [
  ['You pick a question', 'Send the form. It takes about a minute.'],
  ['We answer it', 'We connect the accounts your question needs, then answer it with your own numbers and what people say online. A few slides, the answer on top.'],
  ['We walk you through it', 'A 30-minute call. The slides are yours to keep and share.'],
];
---
<Site title="Try Arcus free: pick a question, get the answer | Arcus" description="Pick the marketing question you’re least sure about. We answer it with your own numbers and what your audience says, then walk you through it. Free, no card." path="/free-report" page="free-report" crumbs={crumbs} schema={schema} navCta={false}>
  {/* Grid areas, not order: phones read crumbs, H1, lead, the form, then what you get. */}
  <section class="frh" aria-labelledby="frh-h">
    <div class="frh-copy">
      <Crumbs items={crumbs} />
      <h1 id="frh-h" class="dh d72">Try it out for free</h1>
      <p class="lead frh-lead">Pick the question you’re least sure about. We answer it with your own numbers and what people say online, then walk you through it in 30 minutes. No card.</p>
    </div>
    <div class="frh-form" id="form">
      <LeadForm id="fr" loc="free-report-form" />
    </div>
    <div class="frh-get">
      <ul class="ticks" aria-label="What you’ll find out">
        {OUTCOMES.map(([o, k]) => <li><span class={`tick ${k}`} aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={ARROW[k]}/></svg></span>{o}</li>)}
      </ul>
      <div class="bill" role="group" aria-labelledby="bill-h">
        <p id="bill-h" class="bill-h">What you get</p>
        <ul class="bill-l">{GET.map((t) => <li><span>{t}</span><span>$0</span></li>)}</ul>
        <p class="bill-tot"><span>Total</span><span>$0</span></p>
        <div class="bill-f"><p>{turnaround ? `Turnaround: ${turnaround}` : 'We tell you the turnaround up front'}</p><span class="bill-stamp">No card</span></div>
      </div>
      {/* Proof beside the ask, as on the homepage: still, uncropped. "What happens next" sits between it and the
          sample answer further down, so no illustrative number is next to or under a client logo. */}
      <ClientWall bare small />
    </div>
  </section>

  <section class="wrap frs" aria-labelledby="next-h">
    <h2 id="next-h" class="dh d56">What happens next</h2>
    <ol class="steps chain fr-steps" style="--n:3" data-once>
      {STEPS.map(([t, d], i) => <li class="step"><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><p class="h3">{t}</p><p class="muted">{d}</p></li>)}
    </ol>
  </section>

  {/* The page's one periwinkle stage: the sample answer, a back card the stage crops (more answers behind it), and
      three numbered markers tied to notes. On wide screens straight leaders join each note to its marker (anchor
      positioning); elsewhere the notes are a numbered list that pairs by number. No label on the card: it names no
      brand and never claims a result; its accessible name says it is a sample. */}
  <section class="wrap frs" aria-labelledby="ex-h">
    <div class="s-peri on-peri fr-ex" data-once>
      <div class="fr-ex-copy">
        <h2 id="ex-h" class="dh d56">The kind of answer you get</h2>
        <p class="lead">Short, sourced, and ending on what to do next.</p>
        <a href="/reports" class="arrow">See real answers <Arrow /></a>
        <ol class="annos" aria-label="What the sample shows">
          {ANNOS.map((t, i) => <li class={`anno n${i + 1}`}><span class="nb" aria-hidden="true">{i + 1}</span>{t}<span class="ld" aria-hidden="true"></span></li>)}
        </ol>
      </div>
      <div class="ex-card">
        <InsightCard surface="stage" marks />
      </div>
    </div>
  </section>

  <PageFAQ id="fr-faq" title="Before you send it" items={[
    ['What do you need from us?', 'Your question, access to the accounts it touches, and 30 minutes for the walkthrough. Usually that means your own numbers (sales, tickets, sign-ups or viewing) and any ad accounts involved. We show you how to connect them.'],
    ['Is it really free?', 'Yes. No card, and no contract. If you want everything connected afterward, we talk about that then.'],
    ['How long does it take?', turnaround ? `${turnaround} from access to answer.` : 'We tell you the turnaround before we start, and email you when your answer is ready.'],
    ['Does it have to be one of the questions in the form?', 'No. Pick “Something else” and tell us what you want to know. Same free answer, same walkthrough.'],
    ['What can you access?', 'Only what you approve before we connect anything. Details are on the Security page.'],
    ['Do our partners need to be involved?', 'If one of them has to grant access to an account your question touches, we tell you before we start. You decide who sees the answer.'],
    ['Why is it free?', 'Because the fastest way to show you what we do is with your own numbers. If the answer is useful, we talk about connecting all your data so you can ask the next one. If it isn’t, you keep the slides.'],
    ['What if the answer is “it’s working”?', 'Then you walk into the next budget review knowing it. Worst case, you were right.'],
  ]}>
    {/* Answering the doubts ends on the ask, right under the last one: back up to the form, focus on its first question
        (site.js initHashLinks). */}
    <a href="#form" class="jb k" data-jelly data-loc="free-report-faq"><span class="bg"></span><span class="lb">Try it out for free</span><Arrow /></a>
  </PageFAQ>

  {/* The short answer stays on the page for search and AI assistants, as quiet prose: the first screen already says it. */}
  <section class="wrap blk-s">
    <QuickAnswer quiet q="How does trying Arcus free work?" a="You pick one marketing question, like which spend paid off, what your audience says about you, or where your next dollar should go. We answer it with your own numbers and what people say online, in a few slides: the answer on top, ending on what to keep, test and stop. Then we walk you through it on a 30-minute call. It’s a free marketing analysis with no card, and it’s how every brand starts with Arcus." />
  </section>

  <section class="wrap frs fr-talk">
    <div class="card fr-talk-in">
      <p class="h3">Rather talk first?</p>
      <div class="btnrow l"><a href={BOOK_URL} class="arrow">Book a call <Arrow /></a><a href="/make-the-case" class="arrow">Get your boss on board <Arrow /></a></div>
    </div>
  </section>
</Site>
