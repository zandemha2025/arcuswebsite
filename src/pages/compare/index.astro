---
import Site from '../../layouts/Site.astro';
import Crumbs from '../../components/Crumbs.astro';
import Close from '../../components/Close.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import Arrow from '../../components/Arrow.astro';
import { COMPARE_ALL as COMPARE } from '../../data/all.js';
import { BOOK_URL } from '../../data/site.js';
const crumbs = [{ name: 'Compare', href: '/compare' }];
---
<Site title="How Arcus compares: software, data teams and testing tools | Arcus" description="How Arcus compares with analytics software, hiring a data team, HAUS, Hex, IRIS and Northbeam. Honest about when each one is the better pick." path="/compare" page="compare" crumbs={crumbs} heroCta>
  <header class="phero l">
    <Crumbs items={crumbs} />
    <h1 class="dh d96">The other ways to get the answer.</h1>
    <p class="lead">Each comparison says when the other option is the better pick. Some of the time, it is.</p>
    <div class="btnrow l">
      <a href="/free-report" class="jb k" data-jelly data-loc="compare-index-hero"><span class="bg"></span><span class="lb">Try it out for free</span><Arrow /></a>
      <a href={BOOK_URL} class="jb ln" data-jelly data-loc="compare-index-hero-2"><span class="bg"></span><span class="lb">Book a call</span></a>
    </div>
    <p class="small muted">Free, no card. Pick a question and we answer it with your own numbers.</p>
    <QuickAnswer q="How is Arcus different?" a="Most options hold one piece or do one job. An attribution tool tracks online sales. A testing tool runs experiments. A listening tool hears the conversation. A data team builds what you hire it to build. Arcus connects all of those pieces, plus your own numbers and what people say, into one place you own, and answers your questions with the whole picture." />
  </header>
  <section class="wrap blk">
    {COMPARE.map((c) => (
      <a href={`/compare/${c.slug}`} class="listrow">
        <span class="h3">vs. {c.name}</span>
        <span class="muted">{c.short || c.lead}</span>
        <span class="go"><Arrow /></span>
      </a>
    ))}
  </section>
  <Close variant="paper" lines={['Compare us on', 'your numbers.']} loc="compare-close" />
</Site>
