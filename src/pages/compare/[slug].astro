---
import Site from '../../layouts/Site.astro';
import Crumbs from '../../components/Crumbs.astro';
import Close from '../../components/Close.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import PageFAQ from '../../components/PageFAQ.astro';
import Related from '../../components/Related.astro';
import AnswerStage from '../../components/AnswerStage.astro';
import Arrow from '../../components/Arrow.astro';
import AskRow from '../../components/AskRow.astro';
import { COMPARE_ALL as COMPARE, COMPARE_DEEP_ALL as COMPARE_DEEP } from '../../data/all.js';
import * as site from '../../data/site.js';
export function getStaticPaths() { return COMPARE.map((c) => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props;
const crumbs = [{ name: 'Compare', href: '/compare' }, { name: `vs. ${c.name}`, href: `/compare/${c.slug}` }];
const d = COMPARE_DEEP[c.slug] || {};
// Mid-sentence name: company names keep their capitals; generic options ("Analytics software") go lowercase.
const nm = c.checked ? c.name : c.name.charAt(0).toLowerCase() + c.name.slice(1);
const { BOOK_URL } = site;
// "Other comparisons" links only the non-vendor pages (software, a data team), never another company's page.
// Vendor pages are the ones that carry a `checked` date for facts taken from that company's site.
const others = COMPARE.filter((x) => x.slug !== c.slug && !x.checked).slice(0, 2);
---
<Site md={`/compare/${c.slug}.md`} title={`${c.h1} | Arcus`} description={c.short || c.lead} path={`/compare/${c.slug}`} page="compare" crumbs={crumbs} heroCta>
  {/* Landing page: the offer, the action and one concrete answer (the sample insight) in the first screen. */}
  <header class="split-hero">
    <div class="stack-24">
      <Crumbs items={crumbs} />
      <h1 id="cmp-h1" class:list={["dh", c.h1.length > 40 ? "d72" : "d96"]}>{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <div class="btnrow l">
        <a href="/free-report" class="jb k" data-jelly data-loc="compare-hero"><span class="bg"></span><span class="lb">Try it out for free</span><Arrow /></a>
        <a href={BOOK_URL} class="jb ln" data-jelly data-loc="compare-hero-2"><span class="bg"></span><span class="lb">Book a call</span></a>
      </div>
      <p class="small muted">Free, no card. Pick a question and we answer it with your own numbers.</p>
    </div>
    <AnswerStage />
  </header>
  <section class="wrap blk-s">
    <QuickAnswer q={`How is Arcus different from ${nm}?`} a={d.summary || c.better} />
  </section>
  <section class="wrap blk-s">
    <div class="tbl" tabindex="0" role="region" aria-label={`Arcus compared with ${c.name}, table`}>
      <table>
        <thead><tr><th scope="col"><span class="sr-only">Compared on</span></th><th scope="col">{c.name}</th><th scope="col" class="us">Arcus</th></tr></thead>
        <tbody>{c.rows.map(([k, a, b]) => <tr><th scope="row">{k}</th><td data-label={c.name}>{a}</td><td class="us" data-label="Arcus">{b}</td></tr>)}</tbody>
      </table>
    </div>
    {c.checked && <p class="tiny faint" style="margin-top:12px">Facts about {c.name} come from its public website. {c.checked}</p>}
    <AskRow loc="compare-table" class="after" note="Try it on your own numbers. Nothing changes until you decide." />
  </section>
  <section class="wrap blk">
    <div class="honest">
      <div><p class="h3">When {nm} is the better pick</p><p class="muted">{c.better}</p></div>
      <div><p class="h3">When Arcus is the better pick</p><p class="muted">When your data sits in pieces across teams, partners and tools, and you want it connected in one place you own: every result counted once against your own numbers, what people say added in, and an answer to whatever you ask next.</p></div>
    </div>
  </section>
  {d.sections && (
  <section class="wrap blk">
    <div class="prose" style="max-width:76ch">{d.sections.map(([h, b]) => <><h2>{h}</h2>{(Array.isArray(b) ? b : String(b).split('\n\n')).map((p) => <p>{p}</p>)}</>)}</div>
  </section>)}
  {d.decide && (
  <section class="slab s-paper" aria-labelledby="dec-h">
    <div class="split">
      <h2 id="dec-h" class="dh d72">How to decide.</h2>
      <div style="display:flex;flex-direction:column;gap:20px"><ul class="nolist yeslist">{d.decide.map((x) => <li>{x}</li>)}</ul>{d.both && <p class="lead"><b>Using both:</b> {d.both}</p>}</div>
    </div>
  </section>)}
  <PageFAQ id="cmp-faq" items={[...(d.faq || []),
    ['Can we use both?', 'Usually, yes. Arcus works alongside the tools and partners you already have. What they produce becomes one more piece of the picture, lined up with your own numbers.'],
    ['How do we try Arcus without switching anything?', 'Try it free. We answer your question with your own numbers and what people say. Nothing changes until you decide.'],
  ]} />
  <Related title="Other comparisons" items={[...others.map((o) => [`vs. ${o.name}`, o.lead, `/compare/${o.slug}`]), ['All comparisons', 'Every option, and when each one is the better pick.', '/compare']]} />
  <Close variant="navy" lines={['Try it on', 'your numbers.']} loc="compare-close" />
</Site>
