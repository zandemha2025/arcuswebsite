---
import Site from '../../layouts/Site.astro';
import Crumbs from '../../components/Crumbs.astro';
import Close from '../../components/Close.astro';
import RealSlide from '../../components/RealSlide.astro';
import { REPORTS } from '../../data/reports.js';
import { SITE } from '../../data/site.js';
const crumbs = [{ name: 'Real answers', href: '/reports' }];
// Real reports first; a report shown with example numbers would always sort last.
const ordered = [...REPORTS].sort((a, b) => Number(!!a.example) - Number(!!b.example));
const schema = [{ '@type': 'CollectionPage', name: 'Real Arcus reports', url: `${SITE}/reports`, hasPart: REPORTS.map((r) => ({ '@type': 'CreativeWork', name: `${r.kind}: ${r.title}`, url: `${SITE}/reports/${r.slug}` })) }];
---
<Site title="Real questions, real answers, names removed | Arcus" description="Real questions Arcus answered for a hard seltzer brand, a streaming service and a skincare brand, with names removed. Flip through the slides and the numbers behind them." path="/reports" active="reports" page="reports" crumbs={crumbs} schema={schema}>
  <header class="phero l rep-h">
    <Crumbs items={crumbs} />
    <h1 class="dh d96">Real questions. Real answers.</h1>
    <p class="lead">Three real brands brought us these questions, and we took their names out. Each answer is a few slides: the answer on top, the numbers behind it, and what to keep, test and stop.</p>
  </header>
  {/* The same navy chapter of real report slides as the homepage, stacked: the real figure on its highlighter with
      its chart at the true ratio, the report's own headline, the question and who asked. No client logo is on this
      page, so each slide names the brand's category. */}
  <section class="ans-s rep-s on-dark" aria-label="Reports">
    <div class="ans rep-ans">
      <ol class="wrap ans-stack">
        {ordered.map((r, i) => <li class="aslide-w" data-once><RealSlide r={r} i={i} who q="h2" /></li>)}
      </ol>
    </div>
  </section>
  <Close variant="paper" lines={['What’s your', 'question?']} loc="reports-close" />
</Site>
