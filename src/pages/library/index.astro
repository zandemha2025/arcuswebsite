---
import Site from '../../layouts/Site.astro';
import Crumbs from '../../components/Crumbs.astro';
import Close from '../../components/Close.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import Arrow from '../../components/Arrow.astro';
import { ALL_ARTICLES as ARTICLES } from '../../data/all.js';
import { TEAM, SITE } from '../../data/site.js';
const crumbs = [{ name: 'Library', href: '/library' }];
const topics = [...new Set(ARTICLES.map((a) => a.topic))];
const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const who = Object.fromEntries(TEAM.map((t) => [t.slug, t]));
const schema = [{ '@type': 'Blog', name: 'The Arcus Library', url: `${SITE}/library`, blogPost: ARTICLES.map((a) => ({ '@type': 'BlogPosting', headline: a.title, url: `${SITE}/library/${a.slug}`, datePublished: a.date })) }];
---
<Site title="Library: how to know what your marketing actually did | Arcus" description="Marketing measurement guides for brand marketers at entertainment and lifestyle brands: see which spend paid off, which posts work, and what your audience says." path="/library" active="library" page="library" crumbs={crumbs} schema={schema}>
  <header class="phero l">
    <Crumbs items={crumbs} />
    <h1 class="dh d96">How to tell what your marketing did.</h1>
    <p class="lead">Short guides for brand marketers. Each starts with the answer. No jargon, and when we have to use a term, we link to what it means.</p>
    <QuickAnswer q="Where should I start?" a="Start with “Incrementality, explained without the math.” It shows how to tell what your marketing caused, in plain words, before you move budget." />
  </header>
  <section class="wrap blk">
    <div class="btnrow l" data-filter="#lib-list" data-live="#lib-live" role="group" aria-label="Filter by topic" style="margin-bottom:12px">
      <button class="chip" type="button" data-val="all" aria-pressed="true">All</button>
      {topics.map((t) => <button class="chip" type="button" data-val={slug(t)} aria-pressed="false">{t}</button>)}
    </div>
    <p id="lib-live" class="tiny faint" aria-live="polite" style="margin-bottom:12px">Showing {ARTICLES.length}</p>
    <div id="lib-list">
      {ARTICLES.map((a) => (
        <a href={`/library/${a.slug}`} class="listrow" data-cat={slug(a.topic)}>
          <span class="tag t-k">{a.topic}</span>
          <span class="stack-6"><span class="h3">{a.title}</span><span class="muted small">{a.dek}</span><span class="tiny faint">By {who[a.author]?.name}</span></span>
          <span class="go"><Arrow /></span>
        </a>
      ))}
    </div>
  </section>
  <section class="wrap blk">
    <div class="tiles" style="--n:2">
      <a class="tile" href="/glossary"><span class="h3">The glossary</span><span class="muted small">Attribution, incrementality, ROAS and the rest, in a sentence each.</span><span class="arrow">Look up a term <Arrow /></span></a>
      <a class="tile" href="/reports"><span class="h3">Real answers</span><span class="muted small">Three questions real brands brought us, answered in a few slides, with the names taken out.</span><span class="arrow">Flip through them <Arrow /></span></a>
    </div>
  </section>
  <Close variant="navy" lines={['Or we answer it', 'for you.']} loc="library-close" />
</Site>
