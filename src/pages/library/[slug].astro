---
import Video from '../../components/Video.astro';
import Site from '../../layouts/Site.astro';
import Crumbs from '../../components/Crumbs.astro';
import Close from '../../components/Close.astro';
import PageFAQ from '../../components/PageFAQ.astro';
import Arrow from '../../components/Arrow.astro';
// The channel guides (<platform>-what-worked) are about what worked, so their asks pre-pick that question.

import { ALL_ARTICLES as ARTICLES } from '../../data/all.js';
import { TEAM, SITE } from '../../data/site.js';
export function getStaticPaths() { return ARTICLES.map((a) => ({ params: { slug: a.slug }, props: { a } })); }
const { a } = Astro.props;
const t = TEAM.find((x) => x.slug === a.author);
// Wide tables scroll inside their own box (never widening the column), and a scroll box needs a keyboard stop and a name.
let tn = 0;
const body = a.body.replace(/<table>/g, () => `<div class="tscroll" tabindex="0" role="region" aria-label="Table ${++tn}, scrolls sideways on small screens"><table>`).replace(/<\/table>/g, '</table></div>');
const toc = [...a.body.matchAll(/<h2 id="([^"]+)">([^<]+)<\/h2>/g)].map((m) => [m[1], m[2]]);
const related = ARTICLES.filter((x) => x.slug !== a.slug && x.topic === a.topic).concat(ARTICLES.filter((x) => x.slug !== a.slug && x.topic !== a.topic)).slice(0, 3);
const crumbs = [{ name: 'Library', href: '/library' }, { name: a.title, href: `/library/${a.slug}` }];
const fmt = new Date(a.date + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const tryHref = /-what-worked$/.test(a.slug) ? '/free-report?start=what_worked' : '/free-report';
const schema = [{ '@type': 'Article', '@id': `${SITE}/library/${a.slug}#article`, headline: a.title, description: a.dek, image: `${SITE}/og/library-${a.slug}.png`, datePublished: a.date, dateModified: a.date, inLanguage: 'en-US', author: { '@id': `${SITE}/about/${a.author}#person`, '@type': 'Person', name: t?.name, url: `${SITE}/about/${a.author}` }, publisher: { '@id': `${SITE}/#org` }, mainEntityOfPage: `${SITE}/library/${a.slug}`, abstract: a.short }];
// Search shows about 60 characters of a title and 160 of a description. These guides' H1 or dek run longer, so
// search gets a shorter version (same claim, same facts); the page itself keeps its own words.
const SEO_TITLE: Record<string, string> = {
  'does-retail-eat-online-sales': 'Does retail eat online sales? Five brands that went retail',
  'watched-vs-shared-share-rate': 'Watched or shared? The hosting hack and share-rate math',
};
const SEO_DESC: Record<string, string> = {
  'google-search-what-worked': 'Search sits right before the purchase, so it collects credit. How to tell if your Google Search ads are working, or just catching people already looking.',
  'meta-what-worked': 'Meta counts a sale as its own if the buyer saw or clicked its ad within a set number of days. How to tell if your Meta ads work, each result counted once.',
};
---
<Site md={`/library/${a.slug}.md`} title={`${SEO_TITLE[a.slug] || a.title} | Arcus`} description={SEO_DESC[a.slug] || a.dek} path={`/library/${a.slug}`} active="library" page="article" crumbs={crumbs} schema={schema} article={{ published: a.date, modified: a.date, author: a.author, section: a.topic }}>
  <header class="phero l art-h">
    <Crumbs items={crumbs} />
    <h1 class="dh d96">{a.title}</h1>
    <p class="lead">{a.dek}</p>
    <div class="byline">
      <a class="person" href={`/about/${a.author}`}><span class="av">{t?.initials}</span><span><b>{t?.name}</b>, {t?.title}<br/><span class="small faint"><time datetime={a.date}>{fmt}</time></span></span></a>
      <span class="tag t-k">{a.topic}</span>
    </div>
  </header>
  <Video page={`/library/${a.slug}`} />
  {/* Reading page: the answer first, then the contents, the article, and the action after it. On wide screens the
      contents travel in the left column (areas, not order); on phones they fold into "On this page" (site.js). */}
  <section class="wrap blk">
    <div class="side art">
      <aside class="qanswer answer art-short" aria-labelledby="short-h">
        <h2 id="short-h" class="h3">The short answer</h2>
        <p class="qa-a">{a.short}</p>
      </aside>
      <nav class="toc art-toc" data-toc aria-label="In this article">
        <details class="toc-d" open data-toc-fold>
          <summary>On this page<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg></summary>
          <div class="toc-l">{toc.map(([id, name]) => <a href={`#${id}`}>{name}</a>)}</div>
        </details>
        <a href={tryHref} class="jb k sm toc-cta" data-jelly data-loc="article-toc"><span class="bg"></span><span class="lb">Try it out for free</span></a>
      </nav>
      <div class="art-body stack-32">
        <article class="prose" data-article={a.slug} set:html={body} />
        <div class="card end-card">
          <p class="h3">Want this answered with your own numbers?</p>
          <p class="muted">Arcus connects every piece of your data, plus what people say online, into one place you own. Pick a question and we answer it free, then walk you through it in 30 minutes. No card.</p>
          {/* Phones: the button (the contents' button is hidden there). Wide: a link, since the contents column already
              carries the primary beside it, and one screen holds one. */}
          <a href={tryHref} class="jb k as end-btn" data-jelly data-loc="article-end"><span class="bg"></span><span class="lb">Try it out for free</span><Arrow /></a>
          <a href={tryHref} class="arrow end-lnk" data-loc="article-end">Try it out for free <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
  {a.faq?.length > 0 && <PageFAQ id="art-faq" items={a.faq} link={false} />}
  <section class="wrap blk">
    <h2 class="h2s mb20">Read next</h2>
    <div class="tiles" style="--n:3">{related.map((r) => <a class="tile" href={`/library/${r.slug}`}><span class="small faint">{r.topic}</span><span class="h3">{r.title}</span><span class="arrow">Read <Arrow /></span></a>)}</div>
  </section>
  <Close variant="paper" lines={['Or we answer it', 'for you.']} loc="article-close" primary={['Try it out for free', tryHref]} />
</Site>
