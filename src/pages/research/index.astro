---
import Site from '../../layouts/Site.astro';
import Crumbs from '../../components/Crumbs.astro';
import Close from '../../components/Close.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import Arrow from '../../components/Arrow.astro';
import { STUDIES } from '../../data/research.js';
const crumbs = [{ name: 'Research', href: '/research' }];
const live = STUDIES.filter((s) => s.published);
const preview = import.meta.env.PUBLIC_PREVIEW === 'true' || import.meta.env.DEV;
const shown = preview ? STUDIES : live;
---
<Site title="Research: what brand audiences do, counted | Arcus" description="Original Arcus research with every number sourced: how young audiences talk online, and what happened to online sales when five brands moved into retail." path="/research" page="research" crumbs={crumbs} noindex={!live.length}>
  <header class="phero l">
    <Crumbs items={crumbs} />
    <h1 class="dh d96">Research, counted.</h1>
    <p class="lead">Original studies, with the method and the numbers published so you can check our work and cite it.</p>
    <QuickAnswer q="What research does Arcus publish?" a="Studies built from public conversation and public sources, counted by hand and by script, with every number traced to a source. Each one ships with its method, its limits and a summary table you can cite." />
  </header>
  <section class="wrap blk">
    {shown.length ? shown.map((s) => (
      <a href={`/research/${s.slug}`} class="listrow">
        <span class="tag t-k">Study</span>
        <span class="stack-6"><span class="h3">{s.title}</span><span class="muted small">{s.short}</span></span>
        <span class="go"><Arrow /></span>
      </a>
    )) : <p class="empty">New studies are on the way. Get them first in <a class="ul" href="/newsletter">The Receipts</a>.</p>}
  </section>
  <Close variant="navy" lines={['Your audience,', 'counted.']} body="These studies use public sources only. Your answer puts what people say next to your own numbers. Try it free, with a 30-minute walkthrough. No card." loc="research-close" />
</Site>
