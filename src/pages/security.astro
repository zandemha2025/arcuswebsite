---
import Site from '../layouts/Site.astro';
import Crumbs from '../components/Crumbs.astro';
import Close from '../components/Close.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import PageFAQ from '../components/PageFAQ.astro';
import * as site from '../data/site.js';
const { TBD } = site;
const { BOOK_URL } = site;
const crumbs = [{ name: 'Security', href: '/security' }];
// Where security questions go. TBD.securityEmail is empty until the founders set it, so the page uses the main address.
const securityEmail = TBD.securityEmail || 'hello@usearcus.ai';
const sections = [
  ['access', 'What we access', ['Only the accounts you approve. When you try it free, that’s just the accounts your question touches. For the full setup, we connect your systems one at a time, and you approve each step: sales, ticketing, viewing or sign-up data, ad accounts, agency reports and social accounts.', 'Before we connect anything, you approve exactly what we can see and do in each account.', 'You can remove our access at any time from each account’s settings.']],
  ['where', 'Where your data lives', ['Everything we build sits in one place inside your own setup, and you own it.']],
  ['who', 'Who sees it', ['We tell you who at Arcus will work with your data before we start.', 'We never share your data, numbers or name with another client, and never publish a report about you without your written permission.']],
  ['ai', 'What the AI can do', ['Our AI can only do jobs we’ve approved: counting results against your numbers, counting posts and comments, drafting slides.', 'Every step it takes is logged.', 'A person on our team reads every answer before you do.']],
  ['end', 'When we stop working together', ['You keep every answer we sent you, and everything we built inside your setup stays yours.']],
  ['legal', 'Paperwork and questions', ['Ask us anything your legal or security team needs to know, such as hosting, encryption, the AI models we use, what happens to your data when we stop, and the paperwork you need.', `Send those questions to ${securityEmail}. Brendon, our CTO, answers them.`]],
];
---
<Site title="Security and data: hand this page to legal | Arcus" description="What Arcus accesses, where your data lives, who sees it, what our AI is allowed to do, and what happens when you leave." path="/security" page="security" crumbs={crumbs}>
  <header class="phero l">
    <Crumbs items={crumbs} />
    <h1 class="dh d96">Hand this page to legal.</h1>
    <p class="lead">What we access, where it lives, who sees it, and what our AI is allowed to do. Brendon, our CTO, answers anything else your legal team needs.</p>
    <QuickAnswer q="Is my data safe with Arcus?" a="We only connect the accounts you approve, and everything we build sits inside your own setup. We log every step our AI takes, and a person reads every answer before you do. You can remove our access at any time." />
  </header>
  <section class="wrap blk">
    <div class="side">
      <nav class="toc" data-toc aria-label="On this page"><div class="toc-l">{sections.map(([id, t]) => <a href={`#${id}`}>{t}</a>)}</div></nav>
      <div style="display:flex;flex-direction:column;gap:48px">
        {sections.map(([id, t, items]) => (
          <section id={id as string} aria-labelledby={`${id}-h`} class="prose">
            <h2 id={`${id}-h`} style="margin-top:0">{t}</h2>
            {(items as string[]).length > 1 ? <ul>{(items as string[]).map((i) => <li>{i}</li>)}</ul> : <p>{(items as string[])[0]}</p>}
            {id === 'ai' && (
              <div class="rc wide" style="margin-top:12px">
                <div class="hd">Approved jobs</div>
                <div class="r pass"><span>Count results against your numbers</span><span>Allowed</span></div>
                <div class="r pass"><span>Count posts and comments</span><span>Allowed</span></div>
                <div class="r pass"><span>Draft slides</span><span>Allowed</span></div>
                <div class="r pass"><span>Log every step</span><span>Allowed</span></div>
                <div class="r x"><span>Backflip</span><span>Not allowed</span></div>
                <div class="r x"><span>Anything else</span><span>Not allowed</span></div>
                <div class="bar"></div>
              </div>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>
  <PageFAQ id="sec-faq" items={[
    ['Can Arcus change anything in our accounts?', 'Nothing you haven’t approved. You decide what we can see and do in each account before we connect it, and you can remove our access at any time.'],
    ['Do you sell or share our data?', 'No. We never sell your data, share it with another client, or publish anything about you without written permission.'],
    ['Can our legal team talk to someone?', 'Yes. Book a call and check the box to bring Brendon, our CTO.'],
  ]} />
  <Close variant="navy" lines={['Questions from', 'legal?']} primary={['Book a call with Brendon', BOOK_URL]} secondary={['Try it out for free', '/free-report']} body="Bring your security and legal questions. Our CTO joins the call." loc="security-close" />
</Site>
