---
import Site from '../layouts/Site.astro';
import Crumbs from '../components/Crumbs.astro';
import Close from '../components/Close.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import PageFAQ from '../components/PageFAQ.astro';
import Related from '../components/Related.astro';
import Arrow from '../components/Arrow.astro';
import AnswerStage from '../components/AnswerStage.astro';
import * as site from '../data/site.js';
const { BOOK_URL } = site;
const crumbs = [{ name: 'Pricing', href: '/pricing' }];
---
<Site title="Pricing: try it free, then setup and monthly | Arcus" description="Try Arcus free on the question you’re least sure about. Then we scope the setup and the monthly work for your brand and quote it once you’ve seen your answer." path="/pricing" active="pricing" page="pricing" crumbs={crumbs} heroCta>
  {/* Landing page: the offer, the action and one concrete answer (the sample insight) in the first screen. */}
  <header class="split-hero">
    <div class="stack-24">
      <Crumbs items={crumbs} />
      <h1 class="dh d96">Itemized, like everything else.</h1>
      <p class="lead">Three lines: try it free, setup, then monthly. The first one costs nothing, and we quote the other two for your brand.</p>
      <div class="btnrow l">
        <a href="/free-report" class="jb k" data-jelly data-loc="pricing-hero"><span class="bg"></span><span class="lb">Try it out for free</span><Arrow /></a>
        <a href={BOOK_URL} class="jb ln" data-jelly data-loc="pricing-hero-2"><span class="bg"></span><span class="lb">Book a call</span></a>
      </div>
      <p class="small muted">Free, no card. Pick a question and we answer it with your own numbers.</p>
    </div>
    <AnswerStage />
  </header>
  <section class="wrap blk-s">
    <QuickAnswer q="How much does Arcus cost?" a="Trying Arcus is free: pick a question and we answer it with your own numbers. If you want Arcus running after that, we scope the setup and the monthly work for your brand and quote it once you’ve seen your free answer. Setup takes about three months." />
  </section>

  <section class="wrap blk">
    <div class="split">
      <div class="rc-wrap price-wrap">
        <div class="rc wide price-rc">
          <div class="hd">Arcus, itemized</div>
          <div class="r"><span>Try it free</span><span>$0</span></div>
          <div class="r"><span>Setup: about three months, done for you</span><span>Quoted</span></div>
          <div class="r"><span>Monthly: answers, reports and listening</span><span>Quoted</span></div>
          <div class="r tot"><span>To start</span><span>$0</span></div>
          <div class="rc-foot"><div class="bar"></div><span class="stamp inline stp rc-stamp">$0 to start</span></div>
        </div>
      </div>
      <div class="stack-16">
        {[
          ['Try it free', '$0', 'Pick a question. We answer it with your own numbers and what people say, then walk you through it in 30 minutes.', ['Your own numbers, lined up with what people say', 'Every number traced to its source', 'What to keep, test and stop'], ['Try it out for free', '/free-report?start=what_worked']],
          ['Setup', 'Quoted', 'About three months to connect every system you run into one place you own, inside your own setup: your own data lake. Answers arrive along the way, and it’s yours to keep.', ['Sales, viewers or players, email and CRM, ads, social and agency reports, connected', 'Built around your brand, so every answer knows your business', 'Listening sources picked for your audience', 'Every number tested before it reaches an answer'], null],
          ['Monthly', 'Quoted', 'Ask anything, any time, plus regular reports on the schedule you pick.', ['Spend, content, audience and market reports', 'A person reads every answer before you do', 'The listening keeps running'], ['Book a call', BOOK_URL]],
        ].map(([t, p, d, items, cta]) => (
          <div class="tile">
            <div class="tile-h"><p class="h2s">{t}</p><p class="h3 num">{p}</p></div>
            <p class="muted">{d}</p>
            <ul class="dash">{(items as string[]).map((i) => <li>{i}</li>)}</ul>
            {cta && <a href={cta[1]} class="arrow">{cta[0]} <Arrow /></a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap blk" aria-labelledby="inc-h">
    {/* Each report wears its data code: worked or flopped (split), your own numbers (teal), what people say and the
        public record (periwinkle), the next dollar (amber, for tests), any question (navy). */}
    <div class="sec-h"><h2 id="inc-h" class="dh d72">What the monthly fee covers.</h2></div>
    <div class="tiles" style="--n:3">
      <div class="tile"><p class="h3 pk-h"><i class="dot wf" aria-hidden="true"></i>Spend reports</p><p class="muted">Which spend paid off, counted once against your own numbers, with what to keep, test and stop.</p></div>
      <div class="tile"><p class="h3 pk-h"><i class="dot p1" aria-hidden="true"></i>Content reports</p><p class="muted">Which posts get watched, which get shared, and what to keep, test and stop. Like the <a class="ul" href="/reports/content-report">real one</a> we made for a hard seltzer brand.</p></div>
      <div class="tile"><p class="h3 pk-h"><i class="dot p3" aria-hidden="true"></i>Audience reports</p><p class="muted">What your audience says across Reddit, TikTok, Discord, Twitch and more, counted and lined up with what they buy.</p></div>
      <div class="tile"><p class="h3 pk-h"><i class="dot p3" aria-hidden="true"></i>Market reports</p><p class="muted">Before a big move, how brands like yours did it, with every number sourced. Like the <a class="ul" href="/reports/market-report">real one</a> for a skincare brand moving into retail.</p></div>
      <div class="tile"><p class="h3 pk-h"><i class="dot nx" aria-hidden="true"></i>Tests</p><p class="muted">Regions-on, regions-off tests when you need to know what caused results before moving budget.</p></div>
      <div class="tile"><p class="h3 pk-h"><i class="dot ink" aria-hidden="true"></i>Any question, any time</p><p class="muted">Ask whatever comes up, and the answer draws on everything we connected. Someone on our team reads every answer before you do and walks you through it.</p></div>
    </div>
  </section>

  <section class="wrap blk" aria-labelledby="not-h">
    <div class="honest" style="grid-template-columns:minmax(0,1fr)">
      <div>
        <h2 id="not-h" class="h3">What Arcus doesn’t do</h2>
        <ul class="nolist">
          <li>Run your ads or buy media</li>
          <li>Make your content</li>
          <li>Replace your agencies or tools. We connect what you already have</li>
          <li>Take a cut of your media spend</li>
          <li>Sell you software seats</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap blk" aria-labelledby="cmp-h">
    <h2 id="cmp-h" class="h2s mb20">Compared with the other ways to get the answer</h2>
    <div class="tbl" tabindex="0" role="region" aria-label="Arcus compared with a data team and analytics software, table">
      <table>
        <thead><tr><th scope="col"><span class="sr-only">Compared on</span></th><th scope="col" class="us">Arcus</th><th scope="col">Hiring a data team</th><th scope="col">Analytics software</th></tr></thead>
        <tbody>
          <tr><th scope="row">Who does the work</th><td class="us" data-label="Arcus">We do</td><td data-label="Hiring a data team">Your hires</td><td data-label="Analytics software">Your team</td></tr>
          <tr><th scope="row">First answer</th><td class="us" data-label="Arcus">When you try it free</td><td data-label="Hiring a data team">After hiring and building</td><td data-label="Analytics software">After setup</td></tr>
          <tr><th scope="row">Reads what your audience says</th><td class="us yes" data-label="Arcus">Yes</td><td data-label="Hiring a data team">If you hire for it</td><td data-label="Analytics software">Usually not</td></tr>
          <tr><th scope="row">People to manage</th><td class="us" data-label="Arcus">None</td><td data-label="Hiring a data team">The team</td><td data-label="Analytics software">Whoever runs it</td></tr>
        </tbody>
      </table>
    </div>
    <p class="small tbl-f"><a class="ul" href="/compare">See every comparison</a></p>
  </section>

  <PageFAQ id="price-faq" items={[
    ['Is trying it really free?', 'Yes. No card and no contract.'],
    ['What does setup include?', 'About three months of connecting every system you run into one place you own, building it around your brand, adding what people say online, and testing every number. We do the work. You approve each step.'],
    ['Are there contracts?', 'Not to try it free. For setup and the monthly work, the terms come with your quote, and we walk you through them.'],
    ['Do we pay for software seats?', 'No. Answers land in Slack, email or Sheets.'],
  ]} />
  <Related items={[['Make the case', 'A one-pager and an email to send your boss.', '/make-the-case'], ['How it works', 'What happens during setup, step by step.', '/how-it-works'], ['Security', 'What we access, and how it’s handled.', '/security']]} />
  <Close variant="navy" lines={['Line one', 'is free.']} loc="pricing-close" />
</Site>
