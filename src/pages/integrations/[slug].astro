---
import Site from '../../layouts/Site.astro';
import Crumbs from '../../components/Crumbs.astro';
import Close from '../../components/Close.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import PageFAQ from '../../components/PageFAQ.astro';
import Logo from '../../components/Logo.astro';
import Arrow from '../../components/Arrow.astro';
import { INTEGRATIONS } from '../../data/all.js';
export function getStaticPaths() { return INTEGRATIONS.map((i) => ({ params: { slug: i.slug }, props: { i } })); }
const { i } = Astro.props;
const pairs = (i.pairsWith || []).map((n) => INTEGRATIONS.find((x) => x.name === n)).filter(Boolean);
const crumbs = [{ name: 'Integrations', href: '/integrations' }, { name: i.name, href: `/integrations/${i.slug}` }];
// Every <title> names its tool, so two pages never share one in search results (the H1 can stay general).
const TITLE: Record<string, string> = {
  snowflake: 'Read your Snowflake data where it already lives',
  databricks: 'Read your Databricks data where it already lives',
  slack: 'Get every answer in Slack, where your team already talks',
  'microsoft-teams': 'Get every answer in Microsoft Teams, where your team already talks',
  klaviyo: 'See what your Klaviyo emails did, counted with everything else',
  'google-sheets': 'Keep your Google Sheets. We’ll connect them',
  'google-drive': 'Point us at the Google Drive folder where reports land',
  hootsuite: 'Line up your Hootsuite posts with what they did for results',
};
const title = TITLE[i.slug] || i.h1.replace(/\.$/, '');
---
<Site md={`/integrations/${i.slug}.md`} title={`${title} | Arcus`} description={i.lead} path={`/integrations/${i.slug}`} page="integration" crumbs={crumbs}>
  <header class="phero l">
    <Crumbs items={crumbs} />
    <h1 class="dh d96">{i.h1}</h1>
    <div class="byline lg-big"><Logo name={i.name} logo={i.logo} size={32} /></div>
    <p class="lead">{i.lead}</p>
    <QuickAnswer q={`What does Arcus read from ${i.name}?`} a={`${i.what} ${i.why}`} />
  </header>
  <section class="wrap blk">
    <div class="split">
      <div class="sec-h m0">
        <h2 class="dh d56">What it answers, connected.</h2>
        <p class="muted">{i.name} is one piece. Once it sits in one place you own, next to your own numbers, your other tools and what people say, these are the questions it helps answer.</p>
        <p class="tiny faint">{i.confirm}</p>
      </div>
      <ol class="numlist">{i.checks.map((c, n) => <li><span class="nl-n">{n + 1}</span><span>{c}</span></li>)}</ol>
    </div>
  </section>
  {pairs.length > 0 && (
  <section class="wrap blk">
    <h2 class="h2s" style="margin-bottom:16px">Often connected alongside</h2>
    <div class="tiles" style={`--n:${pairs.length}`}>{pairs.map((p) => <a class="tile" href={`/integrations/${p.slug}`}><Logo name={p.name} logo={p.logo} size={20} /><span class="muted small">{p.lead}</span><span class="arrow">See how <Arrow /></span></a>)}</div>
  </section>)}
  <PageFAQ id="int-faq" items={i.faq} />
  <Close variant="paper" lines={['One piece.', 'The whole picture.']} loc="integration-close" />
</Site>
