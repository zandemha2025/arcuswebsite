---
import Site from '../../layouts/Site.astro';
import Crumbs from '../../components/Crumbs.astro';
import Close from '../../components/Close.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import Logo from '../../components/Logo.astro';
import { INTEGRATIONS } from '../../data/all.js';
import { SITE, TOOLS } from '../../data/site.js';
const crumbs = [{ name: 'Integrations', href: '/integrations' }];
const cats = [...new Set(INTEGRATIONS.map((i) => i.category))];
const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
// The hero object: four rows of the tools strip's chips, cropped by the well, and the promise in front.
const marked = TOOLS.filter((t) => t.logo && !['ticketmaster', 'walmart', 'roku'].includes(t.logo));
const ROWS = [0, 1, 2, 3].map((k) => marked.slice(k * 6, k * 6 + 6));
const schema = [{ '@type': 'CollectionPage', name: 'Tools Arcus works with', url: `${SITE}/integrations`, hasPart: INTEGRATIONS.map((i) => ({ '@type': 'WebPage', name: `Arcus and ${i.name}`, url: `${SITE}/integrations/${i.slug}` })) }];
---
<Site title="Integrations: the tools Arcus works with | Arcus" description="Arcus plugs into the tools you already use: ad accounts, sales and ticketing, streaming and apps, CRM and email, analytics, spreadsheets and listening tools." path="/integrations" page="integrations" crumbs={crumbs} schema={schema}>
  <header class="phero l">
    <Crumbs items={crumbs} />
    <h1 class="dh d96">Whatever you run, we plug into it.</h1>
    <p class="lead">Your ad accounts, your sales, your CRM, your listening tool, your partners’ decks. Each one holds one piece of the picture. Arcus plugs into all of them, inside your own setup, and connects them into one place you own. Then any question gets answered with the whole picture. Not on the list? We make it work.</p>
    <div class="ph-obj int-obj" aria-hidden="true">
      <div class="po-well">
        {ROWS.map((r, k) => <ul class={`po-chips r${k + 1}`}>{r.map((t) => <li><Logo name={t.name} logo={t.logo} size={18} tint /></li>)}</ul>)}
      </div>
      <div class="po-card front"><span class="pk"><i class="dot p1"></i>One place you own</span><p class="po-t">Every tool you run, connected inside your own setup.</p><p class="po-s">Nothing changes for your team.</p></div>
    </div>
  </header>
  <section class="wrap blk-s">
    <QuickAnswer q="What does Arcus connect to?" a={`Arcus reads the data you already have: ad accounts like Meta, Google, TikTok and LinkedIn; sales, ticketing and streaming numbers; CRM and email; analytics and the systems where your company keeps its data; listening tools; and the spreadsheets and decks your partners send. ${INTEGRATIONS.length} tools are listed here, and if you use something else, we can usually read it.`} />
  </section>
  <section class="wrap blk">
    <div class="btnrow l" data-filter="#int-list" data-live="#int-live" role="group" aria-label="Filter by category" style="margin-bottom:10px">
      <button class="chip" type="button" data-val="all" aria-pressed="true">All</button>
      {cats.map((c) => <button class="chip" type="button" data-val={slug(c)} aria-pressed="false">{c}</button>)}
    </div>
    <p id="int-live" class="tiny faint" aria-live="polite" style="margin-bottom:12px">Showing {INTEGRATIONS.length}</p>
    <ul class="lw" id="int-list" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
      {INTEGRATIONS.map((i) => <li data-cat={slug(i.category)}><a class="stack-6" href={`/integrations/${i.slug}`}><Logo name={i.name} logo={i.logo} size={20} /><span class="small muted">{i.lead}</span><span class="tiny">{i.category}</span></a></li>)}
    </ul>
  </section>
  <Close variant="navy" lines={['Bring the tools', 'you have.']} body="Try it free. We answer your question with your own numbers, wherever they live, plus what people say about you, and walk you through it in 30 minutes. No card." loc="integrations-close" />
</Site>
