---
import fs from 'node:fs';
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AskArcus from '../components/AskArcus.astro';
import { SITE, ENTITY, TEAM, DOMAIN, SAME_AS, BOOK_URL } from '../data/site.js';

interface Crumb { name: string; href?: string }
interface Props {
  title: string;
  description: string;
  path: string;
  active?: string;
  page?: string;
  schema?: Record<string, unknown>[];
  crumbs?: Crumb[];
  noindex?: boolean;
  og?: string;
  article?: { published: string; modified: string; author: string; section: string };
  footer?: boolean;
  ogTitle?: string;
  navCta?: boolean;
  heroCta?: boolean; // the hero has its own primary, so the header's CTA stays unlit until it scrolls away
  heroSurface?: 'photo' | 'light'; // what the header floats over at the top: the homepage photo, or paper
}
const { title: rawTitle, description: rawDescription, path, active = 'none', page = 'page', schema = [], crumbs = [], noindex = false, og, article, footer = true, md, ogTitle, navCta = true, heroCta = path === '/', heroSurface = path === '/' ? 'photo' : 'light' } = Astro.props;
// Search shows about 60 characters of a title. The brand suffix ("| Arcus", "| Arcus glossary", "| The Receipts by
// Arcus") stays only when the whole title fits; otherwise the page's own words win and the suffix drops.
const SUFFIX = / \| (?:Arcus(?: glossary| research)?|The Receipts by Arcus)$/;
const title = rawTitle.length > 60 && SUFFIX.test(rawTitle) ? rawTitle.replace(SUFFIX, '') : rawTitle;
// Placeholders stay on the page ([Check on their site], [Confirm: …]) but never in a search or share snippet.
// Search shows about 160 characters of a description: a longer one keeps the whole sentences that fit, or, when that
// would leave too little, is cut at a word with an ellipsis. Pages whose lead runs long pass a shorter `description`.
const clip = (s: string, max = 160) => {
  if (s.length <= max) return s;
  let out = '';
  for (const x of s.match(/[^.!?]+[.!?]+[’”"]?(?:\s+|$)/g) || []) { if ((out + x).trim().length > max) break; out += x; }
  out = out.trim();
  if (out.length >= 90) return out;
  const cut = s.slice(0, max - 1);
  return `${cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:]$/, '')}…`;
};
const description = clip(String(rawDescription || '').replace(/\s*\[[^\]]*\]/g, '').replace(/\s{2,}/g, ' ').trim());
// Share cards lead with the page's own line where it has one (the homepage: its H1); otherwise the title, without its suffix.
const shareTitle = ogTitle || title.replace(SUFFIX, '');
const canonical = new URL(path, SITE).href.replace(/\/$/, path === '/' ? '/' : '');
// Each page's share image comes from `npm run og`. Pages it skips (noindex: thanks pages, 404, research drafts) or that
// are new since the last run fall back to the homepage image instead of pointing at a missing file.
const ogName = path === '/' ? 'home' : path.replace(/^\//, '').replace(/\/$/, '').replace(/\//g, '-');
const ogImage = new URL(og || (fs.existsSync(`public/og/${ogName}.png`) ? `/og/${ogName}.png` : '/og/home.png'), SITE).href;

const org = {
  '@type': 'Organization', '@id': `${SITE}/#org`, name: 'Arcus', url: `${SITE}/`,
  logo: { '@type': 'ImageObject', url: `${SITE}/logo-512.png`, width: 512, height: 512 },
  description: ENTITY,
  disambiguatingDescription: `Arcus (${DOMAIN}) shows marketing leaders, founders and executives at entertainment and lifestyle brands where their marketing money is working. It is not a biotech, investment or infrastructure firm.`,
  slogan: 'If it can’t be checked, it doesn’t count.',
  knowsAbout: ['marketing measurement', 'marketing data', 'double counting', 'incrementality', 'holdout testing', 'first-party data', 'social listening', 'audience research', 'creator marketing'],
  areaServed: 'US',
  employee: TEAM.map((t) => ({ '@id': `${SITE}/about/${t.slug}#person` })),
  contactPoint: { '@type': 'ContactPoint', contactType: 'sales', url: BOOK_URL.startsWith('/') ? `${SITE}${BOOK_URL}` : BOOK_URL },
  ...(SAME_AS.length ? { sameAs: SAME_AS } : {}),
};
const site = { '@type': 'WebSite', '@id': `${SITE}/#site`, url: `${SITE}/`, name: 'Arcus', publisher: { '@id': `${SITE}/#org` }, inLanguage: 'en-US' };
const bc = crumbs.length ? [{
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, ...(c.href ? { item: new URL(c.href, SITE).href } : {}) })),
}] : [];
const graph = { '@context': 'https://schema.org', '@graph': [org, site, ...bc, ...schema] };

const cfg = {
  posthogKey: import.meta.env.PUBLIC_POSTHOG_KEY || '',
  posthogHost: import.meta.env.PUBLIC_POSTHOG_HOST || '',
  metaPixel: import.meta.env.PUBLIC_META_PIXEL || '',
  linkedinId: import.meta.env.PUBLIC_LINKEDIN_ID || '',
  visitorIdScript: import.meta.env.PUBLIC_VISITOR_ID_SCRIPT || '',
  leadEndpoint: import.meta.env.PUBLIC_LEAD_ENDPOINT || '/api/lead',
  askEndpoint: import.meta.env.PUBLIC_ASK_ENDPOINT || '/api/ask',
  googleAdsId: import.meta.env.PUBLIC_GOOGLE_ADS_ID || '',
  googleAdsLeadLabel: import.meta.env.PUBLIC_GOOGLE_ADS_LEAD_LABEL || '',
  linkedinConversionId: import.meta.env.PUBLIC_LINKEDIN_CONVERSION_ID || '',
  redditPixel: import.meta.env.PUBLIC_REDDIT_PIXEL || '',
  sentryLoader: import.meta.env.PUBLIC_SENTRY_LOADER || '',
  speedInsights: import.meta.env.PUBLIC_SPEED_INSIGHTS === 'true',
  contactEmail: 'hello@usearcus.ai',
  bookUrl: BOOK_URL,
};
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large'} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Arcus" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareTitle} />
    {article && <>
      <meta property="article:published_time" content={article.published} />
      <meta property="article:modified_time" content={article.modified} />
      <meta property="article:author" content={`${SITE}/about/${article.author}`} />
      <meta property="article:section" content={article.section} />
    </>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#F7F6F2" />
    {import.meta.env.PUBLIC_GSC_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />}
    {import.meta.env.PUBLIC_BING_VERIFICATION && <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_VERIFICATION} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Arcus Library" href="/rss.xml" />
    {md && <link rel="alternate" type="text/markdown" href={md} />}
    {/* html.js before first paint (styles that only apply with JS, like the unlit header CTA), and html.still for
        ?still (every end state, for shots). The CSP allows exactly this script by its hash (vercel.json, script-src):
        change one character here and update the hash there (npm run check verifies it). */}
    <script is:inline>document.documentElement.classList.add('js');if(/[?&]still\b/.test(location.search))document.documentElement.classList.add('still')</script>
    <link rel="preload" href="/fonts/anton.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <meta name="arcus-config" content={JSON.stringify(cfg)} />
    <slot name="head" />
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">Skip to content</a>
    {/* First in the tab order after the skip link, so keyboard and screen-reader users meet it first. It's fixed, so
        where it sits in the page doesn't change where it shows. */}
    <aside class="consent" data-consent hidden aria-label="Cookie choices">
      <p class="small"><a class="ul" href="/cookies">Cookies</a> for stats and ads? Your call.</p>
      <div class="btnrow">
        <button class="jb ln sm" type="button" data-consent-choice="all"><span class="bg"></span><span class="lb">Accept all</span></button>
        <button class="jb ln sm" type="button" data-consent-choice="necessary"><span class="bg"></span><span class="lb">Only necessary</span></button>
      </div>
    </aside>
    <Nav active={active} cta={navCta} wait={heroCta ? heroSurface : false} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {footer && <Footer />}
    {import.meta.env.PUBLIC_ASK_ENABLED !== 'false' && <AskArcus />}
    <script>import '../scripts/site.js';</script>
  </body>
</html>
