          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "<https://usearcus.ai/glossary/:slug>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/for/:slug.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
