    },
    {
      "source": "/integrations/:slug.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "<https://usearcus.ai/integrations/:slug>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/research/:slug.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "<https://usearcus.ai/research/:slug>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/pdf/arcus-:slug(audience-report|content-report|market-report).pdf",
      "headers": [
        {
          "key": "Link",
          "value": "<https://usearcus.ai/reports/:slug>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/print/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
